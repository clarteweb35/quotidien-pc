---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Marches from '../components/Marches.astro';
import Gimmick from '../components/Gimmick.astro';
import { allArticles, url, siteName, manualImageCredit } from '../lib/site';
import { illustration } from '../lib/manual';

const articles = await allArticles();
// La une est le dernier article qui a une image: un grand titre sans image donnerait l'impression qu'elle manque.
const illustrated = new Set<string>();
for (const a of articles) if (await illustration(a, 800, manualImageCredit)) illustrated.add(a.id);
const lead = articles.find((a) => illustrated.has(a.id)) ?? articles[0];
const rest = articles.filter((a) => a !== lead);
// Page volontairement legere: EcoIndex compte les elements du DOM (cible: moins de ~350 pour rester en A). Donc 7 dernieres nouvelles,
// quelques valeurs et villes dans les bandeaux, et pas d'extraits par rubrique (le menu les propose deja). Ne pas grossir sans re-mesurer.
const latest = rest.slice(0, 7);
const flash = articles.slice(0, 5);
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL(url(), Astro.site).toString(),
  inLanguage: 'fr-FR',
  description: 'Journal satirique : tous les articles sont des fictions humoristiques.',
};
---
<Base current="home" jsonLd={siteLd}>
  {!lead ? (
    <p class="empty">Le journal est en cours d'impression. Les premiers articles arrivent très bientôt.</p>
  ) : (
    <>
      {flash.length > 1 && (
        <div class="flash" role="region" aria-label="Derniers titres">
          <span class="flash-label">À l'instant</span>
          <div class="flash-viewport"><div class="flash-track">
            {[0, 1].map((copy) => (
              <div class="flash-list" aria-hidden={copy === 1 ? 'true' : undefined}>
                {flash.map((a) => <a href={url(`articles/${a.data.slug}/`)} tabindex={copy === 1 ? -1 : undefined}>{a.data.title}</a>)}
              </div>
            ))}
          </div></div>
        </div>
      )}
      <Marches reverse limit={6} />
      <Card article={lead} lead />
      <Gimmick slug="monde" pill limit={6} />
      <Gimmick slug="accueil" pill />
      {latest.length > 0 && (
        <>
          <h2 class="section-title">Dernières nouvelles (inventées)</h2>
          <div class="grid">{latest.map((a) => <Card article={a} />)}</div>
        </>
      )}
    </>
  )}
</Base>
