---
import Base from '../layouts/Base.astro';
import { roster, authorSlug } from '../lib/authors';
import { siteName } from '../lib/site';
const desks = roster();
---
<Base title="La rédaction" description={`L'équipe fictive de ${siteName}, service par service.`}>
  <div class="prose">
    <div class="page-head">
      <span class="kicker">Qui signe quoi</span>
      <h1>La rédaction</h1>
    </div>
    <div class="satire-box" role="note"><strong>Précision.</strong> Les journalistes présentés ici sont des <strong>personnages fictifs</strong>, créés pour ce journal satirique. Ils n'ont rencontré personne, enquêté sur aucun terrain et ne désignent aucune personne réelle. Toute ressemblance avec un journaliste existant serait une coïncidence.</div>
    {desks.map((d) => (
      <section>
        <h2>{d.label}</h2>
        <ul class="team">
          {d.people.map((p) => (
            <li id={authorSlug(p.name)}>
              <strong>{p.name}</strong> — <em>{p.beat}</em>
              {p.bio && <p>{p.bio}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
