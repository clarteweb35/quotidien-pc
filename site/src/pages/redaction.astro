---
import Base from '../layouts/Base.astro';
import { roster, authorSlug, support, portrait, bureauByDesk, lucasBureau, shotCaption } from '../lib/authors';
import { siteName, url, allArticles } from '../lib/site';
import { rencontres, ancreRef, refTexte, categories as catsRencontres } from '../lib/rencontres';
const desks = roster();
const tous = await allArticles();
const annonceDe = (nom: string) => rencontres.find((r) => r.auteur === nom);
const articlesDe = (nom: string) => tous.filter((a) => a.data.author === nom).slice(0, 3);
const initials = (n: string) => n.split(/[\s-]+/).map((w) => w[0]).slice(0, 2).join('');
// Jean-Eudes (direction) signe aussi les editos: on ne le repete pas dans un service.
const desksShown = desks.map((d) => ({ ...d, people: d.people.filter((p) => !support.some((x) => x.section === 'direction' && x.name === p.name)) })).filter((d) => d.people.length);
const withPhoto = (list: { name: string }[]) => list.map((p) => ({ ...p, photo: portrait(p.name) }));
const staff = (section: string) => withPhoto(support.filter((p) => p.section === section));
const direction = staff('direction');
const secretariat = staff('secretariat');
const backstage = staff('coulisses');
const dessin = staff('dessin');
const nomCatRencontres = (slug: string) => catsRencontres.find((c) => c.slug === slug)?.nom ?? 'Rencontres';
---
<Base manchette={false} title="La rédaction" description={`L'équipe fictive de ${siteName}, service par service.`}>
  <div class="prose">
    <div class="page-head">
      <span class="kicker">Qui signe quoi</span>
      <h1>La rédaction</h1>
    </div>
    <div class="satire-box" role="note"><strong>Précision.</strong> Les journalistes présentés ici sont des <strong>personnages fictifs</strong>, créés pour ce journal satirique. Leurs portraits sont <strong>générés par intelligence artificielle</strong> et ne représentent aucune personne réelle ; il en va de même des photos de bureaux. Ils n'ont rencontré personne, enquêté sur aucun terrain et ne désignent aucune personne réelle. Toute ressemblance avec un journaliste existant serait une coïncidence.</div>

    {direction.length > 0 && (
      <section>
        <h2>Direction</h2>
        <ul class="team">
          {direction.map((p: any) => (
            <li id={authorSlug(p.name)}>
              {p.photo
                ? <img class="avatar" src={url(p.photo)} width="132" height="132" loading="lazy" alt={`Portrait fictif de ${p.name} (image générée par IA)`} />
                : <span class="avatar avatar-none" role="img" aria-label={`Photo de ${p.name} non communiquée`}>{initials(p.name)}</span>}
              <div><strong>{p.name}</strong> — <em>{p.role}</em><p>{p.bio}</p>{articlesDe(p.name).length > 0 && <p class="ses-articles">Derniers éditos : {articlesDe(p.name).map((a, i) => <>{i > 0 && ' · '}<a href={url(`articles/${a.data.slug}/`)}>{a.data.title}</a></>)} · <a href={url('rubrique/editos/')}>Tous les éditos</a></p>}</div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {dessin.length > 0 && (
      <section>
        <h2>Le dessinateur</h2>
        <ul class="team">
          {dessin.map((p: any) => (
            <li id={authorSlug(p.name)}>
              {p.photo
                ? <img class="avatar" src={url(p.photo)} width="132" height="132" loading="lazy" alt={`Portrait fictif de ${p.name} (image générée par IA)`} />
                : <span class="avatar avatar-none" role="img" aria-label={`Photo de ${p.name} non communiquée`}>{initials(p.name)}</span>}
              <div>
                <strong>{p.name}</strong>{p.age && <>, {p.age} ans</>} — <em>{p.role}</em><p>{p.bio}</p>
                <p class="ses-articles">Ses dessins : <a href={url('caricatures/')}>Caricatures, le dessin du jour</a>.</p>
                {annonceDe(p.name) && <p class="ses-articles">Son annonce dans <a href={url(`rencontres/#${ancreRef(annonceDe(p.name)!.ref)}`)}>Rencontres, {nomCatRencontres(annonceDe(p.name)!.cat).toLowerCase()} ({refTexte(annonceDe(p.name)!.ref)})</a>.</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {desksShown.map((d) => (
      <section>
        <h2>{d.label}</h2>
        {bureauByDesk[d.cat.slug] && (
          <figure class="bureau">
            <img src={url(`redaction/bureaux/${bureauByDesk[d.cat.slug]}.webp`)} width="800" height="450" loading="lazy" alt={`Le bureau du ${d.label.toLowerCase()}, vide`} />
            <figcaption>{shotCaption(bureauByDesk[d.cat.slug])}</figcaption>
          </figure>
        )}
        {d.cat.slug === 'environnement' && (
          <aside class="bureau bureau-eco" role="note">
            <strong>Photo du bureau non chargée, pour sauver la planète.</strong> Le service Environnement a exigé de ne pas alourdir le site avec ses images : l'économie est estimée à 40 Ko, soit environ un demi-flocon de glacier. Merci de votre compréhension, et d'éteindre la lumière en partant.
          </aside>
        )}
        <ul class="team">
          {withPhoto(d.people).map((p: any) => (
            <li id={authorSlug(p.name)}>
              {p.photo
                ? <img class="avatar" src={url(p.photo)} width="132" height="132" loading="lazy" alt={`Portrait fictif de ${p.name} (image générée par IA)`} />
                : <span class="avatar avatar-none" title="Photo non communiquée" role="img" aria-label={`Photo de ${p.name} non communiquée`}>{initials(p.name)}</span>}
              <div>
                <strong>{p.name}</strong>{p.age && <>, {p.age} ans</>} — <em>{p.beat}</em>
                {p.bio && <p>{p.bio}</p>}
                {annonceDe(p.name) && <p class="ses-articles">Son annonce dans <a href={url(`rencontres/#${ancreRef(annonceDe(p.name)!.ref)}`)}>Rencontres, {nomCatRencontres(annonceDe(p.name)!.cat).toLowerCase()} ({refTexte(annonceDe(p.name)!.ref)})</a>.</p>}
                {articlesDe(p.name).length > 0 && <p class="ses-articles">Derniers articles : {articlesDe(p.name).map((a, i) => <>{i > 0 && ' · '}<a href={url(`articles/${a.data.slug}/`)}>{a.data.title}</a></>)}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {secretariat.length > 0 && (
      <section>
        <h2>Secrétariat</h2>
        <figure class="bureau">
          <img src={url('redaction/bureaux/secretariat.webp')} width="800" height="450" loading="lazy" alt="Le bureau d'accueil, vide, sous le logo du journal" />
          <figcaption>{shotCaption('secretariat')}</figcaption>
        </figure>
        <ul class="team">
          {secretariat.map((p: any) => (
            <li id={authorSlug(p.name)}>
              {p.photo
                ? <img class="avatar" src={url(p.photo)} width="132" height="132" loading="lazy" alt={`Portrait fictif de ${p.name} (image générée par IA)`} />
                : <span class="avatar avatar-none" title="Photo non communiquée" role="img" aria-label={`Photo de ${p.name} non communiquée`}>{initials(p.name)}</span>}
              <div><strong>{p.name}</strong> — <em>{p.role}</em><p>{p.bio}</p></div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2>Coulisses</h2>
      <figure class="bureau">
        <img src={url('redaction/bureaux/lucas.webp')} width="800" height="450" loading="lazy" alt={lucasBureau.alt} />
        <figcaption>{shotCaption('lucas')}</figcaption>
      </figure>
      <ul class="team">
        {backstage.map((p: any) => (
          <li id={authorSlug(p.name)}>
            {p.photo
              ? <img class="avatar" src={url(p.photo)} width="132" height="132" loading="lazy" alt={`Portrait fictif de ${p.name} (image générée par IA)`} />
              : <span class="avatar avatar-none" title="Photo non communiquée" role="img" aria-label={`Photo de ${p.name} non communiquée`}>{initials(p.name)}</span>}
            <div>
              <strong>{p.name}</strong>{p.age && <>, {String(p.age).replace('.', ',')} ans</>} — <em>{p.role}</em><p>{p.bio}</p>
              {articlesDe(p.name).length > 0 && <p class="ses-articles">Derniers articles : {articlesDe(p.name).map((a, i) => <>{i > 0 && ' · '}<a href={url(`articles/${a.data.slug}/`)}>{a.data.title}</a></>)}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="recrute">
      <h2>Vous aimez les défis superflus ?</h2>
      <p>Le Quotidien Presque Certain recherche constamment des talents prêts à consacrer leur temps à des sujets d'une importance hautement discutable. Que vous maîtrisiez la langue française à peu près ou que vous sachiez juste faire du café sans brûler la machine, votre place est peut-être ici.</p>
      <p>Envoyez votre candidature (sans photo, Véronique juge déjà assez sur pièce) à : <span class="fake-mail">recrutement@quotidien-pc.fr</span> (adresse fictive, voir les <a href={url('mentions-legales/#recrutement')}>mentions légales</a> ; ou glissez une note sous la porte de Fabienne, si elle daigne bouger).</p>
    </section>
  </div>
</Base>
