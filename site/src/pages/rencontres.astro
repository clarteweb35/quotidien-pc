---
import Base from '../layouts/Base.astro';
import { page, rencontres, parCategorie, refTexte, ancreRef, photoExistante } from '../lib/rencontres';
import { url } from '../lib/site';
---
<Base title={page.titreSeo} description={page.descriptionSeo} current="rencontres">
  <div class="page-head">
    <span class="kicker">Rubrique</span>
    <h1>{page.titre}</h1>
    <p class="rc-intro">{page.intro}</p>
    <p class="meta">{page.chapeau}</p>
  </div>

  <nav class="rc-sommaire" aria-label="Sections de la rubrique">
    <ul>
      {parCategorie.map((c) => <li><a href={`#${c.slug}`}>{c.nom}</a> <span>({c.annonces.length})</span></li>)}
    </ul>
    <p>{rencontres.length} annonces fictives, chacune dotée d'une référence d'imprimerie qui ne permet de joindre personne.</p>
  </nav>

  {parCategorie.map((c) => (
    <section class="rc-section" id={c.slug} aria-labelledby={`t-${c.slug}`}>
      <h2 id={`t-${c.slug}`} class="rc-rubrique">{c.nom}</h2>
      <div class="rc-colonnes">
        {c.annonces.map((r) => {
          const photo = photoExistante(r);
          return (
            <article class="rc" id={ancreRef(r.ref)}>
              <p class="rc-ref"><a href={`#${ancreRef(r.ref)}`}>{refTexte(r.ref)}</a></p>
              <div class="rc-corps">
                {photo && <img class="rc-photo" src={url(photo)} width="72" height="90" alt={r.photoAlt ?? 'Portrait fictif généré par IA'} loading="lazy" />}
                <h3 class="rc-profil">{r.profil}</h3>
                <p>{r.texte}</p>
                {r.recherche && <p class="rc-recherche"><strong>Recherche :</strong> {r.recherche}</p>}
                {r.formule && <p class="rc-formule">{r.formule}</p>}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <aside class="rc-mention" role="note">{page.mention}</aside>
</Base>

<style>
  .rc-intro { font: italic 1.2rem/1.45 var(--serif); margin: 4px 0 8px; max-width: 46rem; }
  .rc-sommaire { margin: 18px 0 8px; padding: 10px 14px; border-top: 3px double var(--ink); border-bottom: 1px solid var(--rule); font-family: var(--sans); }
  .rc-sommaire ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: .88rem; }
  .rc-sommaire a { color: var(--ink); font-weight: 700; }
  .rc-sommaire span { color: var(--ink-2); }
  .rc-sommaire p { margin: 8px 0 0; font-size: .8rem; color: var(--ink-2); }
  .rc-section { margin-top: 30px; scroll-margin-top: 12px; }
  .rc-rubrique { font: 800 .85rem var(--sans); letter-spacing: .14em; text-transform: uppercase; margin: 0 0 4px; padding: 6px 0; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .rc-colonnes { column-width: 300px; column-gap: 30px; column-rule: 1px solid var(--rule); }
  .rc { break-inside: avoid; display: grid; grid-template-columns: 5.4rem 1fr; gap: 0 10px; padding: 12px 0; border-bottom: 1px dotted var(--ink); font-family: var(--serif); }
  .rc-ref { margin: 0; font: 800 .72rem/1.3 var(--sans); letter-spacing: .06em; }
  .rc-ref a { color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .rc-corps p { margin: 0 0 6px; font-size: .98rem; line-height: 1.5; }
  .rc-profil { font: 700 1rem/1.3 var(--serif); margin: 0 0 4px; }
  .rc-recherche strong { font: 700 .72rem var(--sans); letter-spacing: .06em; text-transform: uppercase; }
  .rc-formule { font-style: italic; color: var(--ink-2); }
  .rc-photo { float: right; margin: 0 0 6px 10px; border: 1px solid var(--ink); object-fit: cover; filter: grayscale(1); }
  .rc-mention { margin: 32px 0 0; padding: 10px 14px; border-top: 1px solid var(--rule); font: .78rem/1.5 var(--sans); color: var(--ink-2); text-align: center; }
  @media (max-width: 480px) { .rc { grid-template-columns: 1fr; } .rc-ref { margin-bottom: 4px; } }
</style>
