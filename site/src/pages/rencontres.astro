---
import Base from '../layouts/Base.astro';
import { page, rencontres, parCategorie, refTexte, ancreRef, photoExistante } from '../lib/rencontres';
import { url } from '../lib/site';
import { authorSlug } from '../lib/authors';
import { partenaire } from '../lib/annonces';
import EncartAnnonces from '../components/EncartAnnonces.astro';
---
<Base manchette={false} title={page.titreSeo} description={page.descriptionSeo} current="rencontres">
  <div class="page-head">
    <span class="kicker">Rubrique</span>
    <h1>{page.titre}</h1>
    <p class="rc-intro">{page.intro}</p>
    <p class="meta">{page.chapeau}</p>
  </div>

  {partenaire && (
    <aside class="agence" aria-labelledby="agence-titre">
      <div class="agence-ruban"><span>{partenaire.mention}</span></div>
      <div class="agence-corps">
        <figure class="agence-portrait">
          <img src={url(`annonces/${partenaire.image}`)} width="230" height="288" alt={partenaire.imageAlt} loading="lazy" />
          <figcaption>{partenaire.auteur}</figcaption>
        </figure>
        <div class="agence-texte">
          <h2 id="agence-titre">{partenaire.nom}</h2>
          <p class="agence-slogan">{partenaire.slogan}</p>
          <p class="agence-intro">{partenaire.texte}</p>
          <div class="agence-duo">
            {partenaire.details.map((d, i) => (
              <div class="agence-carte">
                <span class="agence-num" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
                <h3>{d.label}</h3>
                <p>{d.texte}</p>
              </div>
            ))}
          </div>
          <blockquote class="agence-citation"><p>{partenaire.citation}</p><footer>— {partenaire.auteur}</footer></blockquote>
          {partenaire.lien && <p class="agence-lien"><a href={url(partenaire.lien)}>{partenaire.lienTexte} →</a></p>}
        </div>
      </div>
    </aside>
  )}

  <nav class="rc-sommaire" aria-label="Sections de la rubrique">
    <ul>
      {parCategorie.map((c) => <li><a href={`#${c.slug}`}>{c.nom}</a> <span>({c.annonces.length})</span></li>)}
    </ul>
    <p>{rencontres.length} annonces fictives, chacune dotée d'une référence d'imprimerie qui ne permet de joindre personne.</p>
  </nav>

  {parCategorie.map((c) => (
    <section class="rc-section" id={c.slug} aria-labelledby={`t-${c.slug}`}>
      <h2 id={`t-${c.slug}`} class="rc-rubrique">{c.nom}</h2>
      <div class="rc-colonnes">
        {c.annonces.map((r) => {
          const photo = photoExistante(r);
          return (
            <article class="rc" id={ancreRef(r.ref)}>
              <p class="rc-ref"><a href={`#${ancreRef(r.ref)}`}>{refTexte(r.ref)}</a></p>
              <div class="rc-corps">
                {!photo && <span class="rc-photo rc-photo-vide" role="img" aria-label="Pas d'image fournie">Pas d'image fournie</span>}
                {photo && <img class="rc-photo" src={url(photo)} width="72" height="90" alt={r.photoAlt ?? 'Portrait fictif généré par IA'} loading="lazy" />}
                <h3 class="rc-profil">{r.profil}</h3>
                <p>{r.texte}</p>
                {r.recherche && <p class="rc-recherche"><strong>Recherche :</strong> {r.recherche}</p>}
                {r.formule && <p class="rc-formule">{r.formule}</p>}
                {r.auteur && <p class="rc-auteur">Annonce déposée par <a href={url(`redaction/#${authorSlug(r.auteur)}`)}>{r.auteur}</a>, de la rédaction.</p>}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <section class="rc-encart" aria-label="Les petites annonces du journal"><div class="grid"><EncartAnnonces /></div></section>

  <aside class="rc-mention" role="note">{page.mention}</aside>
</Base>

<style>
  /* Agence partenaire: affiche noir et or, portrait cadre, deux cartes numerotees, grande citation */
  .agence { margin: 24px 0 8px; background: #0e0d0a; color: #faf7f2; border: 1px solid #c89658; box-shadow: inset 0 0 0 6px #0e0d0a, inset 0 0 0 7px #c89658; }
  .agence-ruban { padding: 9px 18px; background: #c89658; color: #0e0d0a; text-align: center; font: 800 .74rem var(--sans); letter-spacing: .24em; text-transform: uppercase; }
  .agence-corps { display: grid; grid-template-columns: 230px 1fr; gap: 28px; padding: 26px 30px 28px; }
  .agence-portrait { margin: 0; align-self: start; text-align: center; }
  .agence-portrait img { display: block; width: 230px; height: 288px; object-fit: cover; object-position: 50% 12%; border: 3px solid #c89658; padding: 5px; background: #0e0d0a; }
  .agence-portrait figcaption { margin-top: 8px; padding-top: 6px; border-top: 1px solid #c89658; font: italic .9rem var(--serif); color: #e8c58f; }
  .agence h2 { margin: 0; font: 700 clamp(1.7rem, 3.4vw, 2.5rem)/1.1 var(--serif); }
  .agence-slogan { margin: 6px 0 14px; padding-bottom: 12px; border-bottom: 1px solid rgba(200, 150, 88, .5); font: italic 1.2rem var(--serif); color: #e8c58f; }
  .agence-intro { margin: 0 0 16px; font: 1.04rem/1.6 var(--serif); text-align: justify; hyphens: auto; }
  .agence-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
  .agence-carte { position: relative; padding: 14px 16px 14px 16px; border: 1px solid rgba(200, 150, 88, .6); background: rgba(200, 150, 88, .08); }
  .agence-num { position: absolute; right: 12px; top: 2px; font: 700 2.6rem/1 var(--serif); color: rgba(200, 150, 88, .3); }
  .agence-carte h3 { margin: 0 0 6px; font: 800 .74rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: #e8c58f; }
  .agence-carte p { margin: 0; font: .95rem/1.5 var(--serif); text-align: justify; hyphens: auto; }
  .agence-citation { position: relative; margin: 0; padding: 4px 0 0 56px; }
  .agence-citation::before { content: '\201C'; position: absolute; left: 0; top: -14px; font: 700 5.4rem/1 var(--serif); color: #c89658; }
  .agence-citation p { margin: 0; font: italic 1.4rem/1.35 var(--serif); }
  .agence-citation footer { margin-top: 6px; font: .82rem var(--sans); letter-spacing: .06em; text-transform: uppercase; color: #e8c58f; }
  .agence-lien { margin: 16px 0 0; }
  .agence-lien a { display: inline-block; padding: 8px 16px; background: #c89658; color: #0e0d0a; font: 800 .88rem var(--sans); text-decoration: none; }
  @media (max-width: 760px) { .agence-corps { grid-template-columns: 1fr; padding: 20px 18px; } .agence-portrait img { width: 190px; height: 238px; margin: 0 auto; } .agence-duo { grid-template-columns: 1fr; } .agence-citation { padding-left: 44px; } .agence-citation p { font-size: 1.15rem; } }
  .rc-intro { font: italic 1.2rem/1.45 var(--serif); margin: 4px 0 8px; max-width: none; }
  .rc-sommaire { margin: 18px 0 8px; padding: 10px 14px; border-top: 3px double var(--ink); border-bottom: 1px solid var(--rule); font-family: var(--sans); }
  .rc-sommaire ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 22px; font-size: .88rem; }
  .rc-sommaire a { color: var(--ink); font-weight: 700; }
  .rc-sommaire span { color: var(--ink-2); }
  .rc-sommaire p { margin: 8px 0 0; font-size: .8rem; color: var(--ink-2); text-align: center; }
  .rc-encart { margin-top: 34px; }
  .rc-encart .grid { margin-top: 0; }
  .rc-section { margin-top: 30px; scroll-margin-top: 12px; }
  .rc-rubrique { font: 800 .85rem var(--sans); letter-spacing: .14em; text-transform: uppercase; margin: 0 0 4px; padding: 6px 0; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .rc-colonnes { column-width: 300px; column-gap: 30px; column-rule: 1px solid var(--rule); }
  .rc { break-inside: avoid; display: grid; grid-template-columns: 5.4rem 1fr; gap: 0 10px; padding: 12px 0; border-bottom: 1px dotted var(--ink); font-family: var(--serif); }
  .rc-ref { margin: 0; font: 800 .72rem/1.3 var(--sans); letter-spacing: .06em; }
  .rc-ref a { color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .rc-corps p { margin: 0 0 6px; font-size: .98rem; line-height: 1.5; }
  .rc-profil { font: 700 1rem/1.3 var(--serif); margin: 0 0 4px; }
  .rc-recherche strong { font: 700 .72rem var(--sans); letter-spacing: .06em; text-transform: uppercase; }
  .rc-formule { font-style: italic; color: var(--ink-2); }
  .rc-photo-vide { display: grid; place-items: center; width: 72px; height: 90px; padding: 4px; box-sizing: border-box; text-align: center; font: 600 .6rem/1.2 var(--sans); color: var(--ink-2); background: repeating-linear-gradient(135deg, #efe9dc 0 6px, #f6f1e6 6px 12px); filter: none; }
  .rc-auteur { font: .8rem var(--sans); color: var(--ink-2); }
  .rc-auteur a { color: var(--link); font-weight: 700; }
  .rc-photo { float: right; margin: 0 0 6px 10px; border: 1px solid var(--ink); object-fit: cover; filter: grayscale(1); }
  .rc-mention { margin: 32px 0 0; padding: 10px 14px; border-top: 1px solid var(--rule); font: .78rem/1.5 var(--sans); color: var(--ink-2); text-align: center; }
  @media (max-width: 480px) { .rc { grid-template-columns: 1fr; } .rc-ref { margin-bottom: 4px; } }
</style>
