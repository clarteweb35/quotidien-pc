---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allArticles, category, formatDateTime, readingMinutes, satireNotice, siteName, url, manualImageCredit } from '../../lib/site';
import { illustration } from '../../lib/manual';
import { refOf } from '../../lib/ref';
import { journalist, deskLabel, authorSlug, portrait } from '../../lib/authors';
import Share from '../../components/Share.astro';
import PubAnnonce from '../../components/PubAnnonce.astro';
import Card from '../../components/Card.astro';

export async function getStaticPaths() {
  const articles = await allArticles();
  return articles.map((a) => ({ params: { slug: a.data.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const all = await allArticles();
const d = article.data;
const cat = category(d.category);
// Maillage interne: precedent/suivant dans la meme rubrique et autres articles de la meme signature.
const memeRubrique = all.filter((x) => x.data.category === d.category);
const rang = memeRubrique.findIndex((x) => x.id === article.id);
const plusRecent = rang > 0 ? memeRubrique[rang - 1] : null;
const plusAncien = rang >= 0 && rang < memeRubrique.length - 1 ? memeRubrique[rang + 1] : null;
const dumemeAuteur = d.author ? all.filter((x) => x.id !== article.id && x.data.author === d.author).slice(0, 4) : [];
const related = all
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => ({
    article: candidate,
    sameCategory: candidate.data.category === d.category,
    sharedTags: candidate.data.tags.filter((tag) => d.tags.includes(tag)).length,
  }))
  .sort((a, b) => Number(b.sameCategory) - Number(a.sameCategory) || b.sharedTags - a.sharedTags || b.article.data.publishedAt.getTime() - a.article.data.publishedAt.getTime())
  .slice(0, 3)
  .map(({ article: candidate }) => candidate);
const { Content } = await render(article);
const img = await illustration(article, 1280, manualImageCredit);
const ref = refOf(d);
const who = journalist(d.author);
const photo = who ? portrait(who.name) : null;
const minutes = readingMinutes(article.body);
const isEdito = d.category === 'editos';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.publishedAt.toISOString(),
  inLanguage: 'fr-FR',
  articleSection: cat.name,
  keywords: d.tags.join(', '),
  author: who ? { '@type': 'Person', name: who.name, description: 'Signature fictive du journal satirique' } : { '@type': 'Organization', name: siteName },
  publisher: { '@type': 'Organization', name: siteName },
  ...(img ? { image: new URL(img.src, Astro.site).toString() } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={d.title} description={d.description} type="article" current={cat.slug} jsonLd={jsonLd} ogImage={url(`og/${d.slug}.png`)}>
  <div class="progress" aria-hidden="true"></div>
  <PubAnnonce seed={d.slug} />
  <nav class="fil" aria-label="Fil d'Ariane">
    <a href={url()}>Accueil</a> <span aria-hidden="true">›</span> <a href={url(`rubrique/${cat.slug}/`)}>{cat.name}</a>
  </nav>
  <article class:list={['article', isEdito && 'article-edito']}>
    <a class="kicker" href={url(`rubrique/${cat.slug}/`)}>{isEdito ? 'Édito' : cat.name}</a>
    <h1>{d.title}</h1>
    <p class="chapo">{d.chapo}</p>
    {isEdito && photo && <img class="avatar avatar-lg edito-portrait" src={url(photo)} width="150" height="150" alt={`Portrait fictif de ${who!.name} (image générée par IA)`} />}
    <p class="byline">
      {!isEdito && photo && <img class="avatar avatar-sm" src={url(photo)} width="40" height="40" alt={`Portrait fictif de ${who!.name} (image générée par IA)`} />}
      {who ? <>Par <a href={url(`redaction/#${authorSlug(who.name)}`)}>{who.name}</a> · {isEdito ? 'rédacteur en chef' : deskLabel(d.category)}</> : <>Par la rédaction</>} · Lecture : {minutes} min
    </p>
    <div class="meta">
      Publié le <time datetime={d.publishedAt.toISOString()}>{formatDateTime(d.publishedAt)}</time> · <strong>Satire</strong>{ref && <> · <span class="ref" title="Référence de l'article">Réf. {ref}</span></>}
    </div>
    <Share title={d.title} url={canonicalUrl} id="share-top" />
    {img && (
      <figure class="illus">
        <img src={img.src} srcset={img.srcset} sizes="(min-width: 760px) 720px, 100vw" alt={img.alt} width={img.width} height={img.height} fetchpriority="high" />
        <figcaption>{img.credit} — illustration satirique, sans rapport avec des faits réels.</figcaption>
      </figure>
    )}
    <div class="satire-box" role="note"><strong>Article satirique.</strong> {satireNotice}</div>
    <div class="body"><Content /></div>
    {isEdito && who && <p class="edito-signature">— {who.name}, rédacteur en chef</p>}
    <Share title={d.title} url={canonicalUrl} id="share-bottom" />
    {d.tags.length > 0 && (
      <ul class="tags" aria-label="Mots-clés">
        {d.tags.map((t) => <li><a href={url(`tag/${encodeURIComponent(t)}/`)}>#{t}</a></li>)}
      </ul>
    )}
    {d.sources.length > 0 && (
      <p class="sources">
        Actualité ayant inspiré cette fiction :
        {d.sources.map((s) => <> <a href={s.url} rel="noopener nofollow external">{s.name}</a></>)}.
        Le contenu ci-dessus est entièrement parodique.
      </p>
    )}
    {(plusRecent || plusAncien) && (
      <nav class="suivant" aria-label="Dans la même rubrique">
        {plusAncien ? <a class="precedent" href={url(`articles/${plusAncien.data.slug}/`)}><span>← Plus ancien · {cat.name}</span>{plusAncien.data.title}</a> : <span />}
        {plusRecent ? <a class="suite" href={url(`articles/${plusRecent.data.slug}/`)}><span>Plus récent · {cat.name} →</span>{plusRecent.data.title}</a> : <span />}
      </nav>
    )}
    {dumemeAuteur.length > 0 && who && (
      <aside class="meme-auteur" aria-labelledby="meme-auteur-titre">
        <h2 id="meme-auteur-titre">Du même auteur : <a href={url(`redaction/#${authorSlug(who.name)}`)}>{who.name}</a></h2>
        <ul>{dumemeAuteur.map((x) => <li><a href={url(`articles/${x.data.slug}/`)}>{x.data.title}</a></li>)}</ul>
      </aside>
    )}
    {related.length > 0 && (
      <aside class="related" aria-labelledby="related-title">
        <h2 id="related-title">À lire aussi</h2>
        <div class="grid">{related.map((item) => <Card article={item} />)}</div>
      </aside>
    )}
  </article>
</Base>
