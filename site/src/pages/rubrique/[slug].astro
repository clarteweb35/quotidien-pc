---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Marches from '../../components/Marches.astro';
import Resultats from '../../components/Resultats.astro';
import Gimmick from '../../components/Gimmick.astro';
import EcoExtras from '../../components/EcoExtras.astro';
import { allArticles, categories, url } from '../../lib/site';
import { journalist, portrait } from '../../lib/authors';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const articles = (await allArticles()).filter((a) => a.data.category === cat.slug);
// Maillage: mots-cles les plus frequents de la rubrique (seuls ceux de 3 articles et plus ont une page indexee, mais tous restent navigables).
const compteTags = new Map<string, number>();
for (const a of articles) for (const t of a.data.tags) compteTags.set(t, (compteTags.get(t) ?? 0) + 1);
const motsCles = [...compteTags].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0], 'fr')).slice(0, 8).map(([t]) => t);
const editorialiste = cat.slug === 'editos' ? journalist('Jean-Eudes de la Manchette') : null;
const photoEdito = editorialiste ? portrait(editorialiste.name) : null;
---
<Base title={cat.name} description={cat.description} current={cat.slug}>
  <div class="page-head">
    <span class="kicker">Rubrique</span>
    <h1>{cat.name}</h1>
    <p class="meta">{cat.description}</p>
    {editorialiste && (
      <div class="edito-pupitre">
        {photoEdito && <img class="avatar avatar-lg" src={url(photoEdito)} width="96" height="96" alt={`Portrait fictif de ${editorialiste.name} (image générée par IA)`} />}
        <p><strong>{editorialiste.name}</strong>, rédacteur en chef et fondateur autoproclamé, signe seul cette page. Ses avis sont tranchés, mal informés et définitifs, sur des sujets de société ou de politique internationale dont il ne maîtrise pas le détail.</p>
      </div>
    )}
  </div>
  {cat.slug === 'economie' && <Marches />}
  {cat.slug === 'sport' && <Resultats />}
  <Gimmick slug={cat.slug} pill={['economie', 'sport'].includes(cat.slug)} />
  {articles.length === 0 ? <p class="empty">Rien à signaler dans cette rubrique. Pour l'instant.</p> : (
    <div class="grid">{articles.map((a) => <Card article={a} />)}</div>
  )}
  {cat.slug === 'economie' && <EcoExtras />}
  {motsCles.length > 0 && (
    <nav class="mots-cles" aria-label="Mots-clés de la rubrique">
      <span>Mots-clés :</span> {motsCles.map((t) => <a href={url(`tag/${encodeURIComponent(t)}/`)}>#{t}</a>)}
    </nav>
  )}
</Base>
