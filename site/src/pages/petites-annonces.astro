---
import Base from '../layouts/Base.astro';
import { rubrique, categoriesAnnonces, annonces, agence, manchetteRencontres } from '../lib/annonces';
import { url as lien } from '../lib/site';
import { contactEmail } from '../lib/legal';
import { url } from '../lib/site';
import { melangeDuJour } from '../lib/melange';
import AnnonceCarte from '../components/AnnonceCarte.astro';
import PubDefilante from '../components/PubDefilante.astro';

const compte = (slug: string) => annonces.filter((a) => a.cat === slug).length;
const milieu = Math.ceil(annonces.length / 2);
// Ordre different chaque jour (graine = date de Paris), stable pendant la journee
const duJour = melangeDuJour(annonces, 'petites-annonces');
const premieres = duJour.slice(0, milieu);
const dernieres = duJour.slice(milieu);
---
<Base manchette={false} title={rubrique.titre} description={`${rubrique.accroche} ${annonces.length} annonces fictives et satiriques.`} current="annonces">
  <div class="page-head">
    <span class="kicker">Rubrique</span>
    <h1>{rubrique.titre}</h1>
    <p class="pa-accroche">{rubrique.accroche}</p>
    <p class="meta">{rubrique.intro}</p>
  </div>

  <section class="pa-outils" aria-label="Filtrer les annonces">
    <div class="pa-filtres" role="group" aria-label="Catégories">
      <button type="button" class="pa-filtre" data-cat="toutes" aria-pressed="true">Toutes les annonces <span class="pa-n">{annonces.length}</span></button>
      {categoriesAnnonces.map((c) => <button type="button" class="pa-filtre" data-cat={c.slug} aria-pressed="false">{c.name} <span class="pa-n">{compte(c.slug)}</span></button>)}
    </div>
    <div class="pa-ligne">
      <label class="pa-recherche">
        <span>Rechercher</span>
        <input type="search" id="pa-recherche" placeholder="chaise, stage, réunion…" autocomplete="off" />
      </label>
      <p class="pa-compteur" id="pa-compteur" role="status" aria-live="polite">{annonces.length} annonces</p>
      <details class="pa-depot" id="pa-depot">
        <summary>Déposer une annonce</summary>
        <div class="pa-depot-corps">
          <p><strong>Comment ça marche ?</strong> Vous rédigez votre proposition ici ; le bouton ouvre votre messagerie avec le message prêt à partir pour <a href={`mailto:${contactEmail}`}>{contactEmail}</a>. La rédaction lit tout, ne publie rien automatiquement et ne répond pas à toutes les propositions.</p>
          <p class="meta">Ce formulaire n'enregistre rien sur ce site : aucun serveur ne reçoit votre texte. N'indiquez ni coordonnées personnelles ni offre réelle : les annonces de cette rubrique sont satiriques.</p>
          <form id="pa-form" class="pa-form">
            <label>Titre de l'annonce <input type="text" name="titre" maxlength="90" required /></label>
            <label>Catégorie
              <select name="cat">{categoriesAnnonces.map((c) => <option value={c.name}>{c.name}</option>)}</select>
            </label>
            <label>Texte <textarea name="texte" rows="4" maxlength="500" required></textarea></label>
            <label>Prix (facultatif) <input type="text" name="prix" maxlength="40" /></label>
            <button type="submit">Ouvrir ma messagerie</button>
          </form>
        </div>
      </details>
    </div>
  </section>

  <section aria-labelledby="pa-titre-liste">
    <h2 id="pa-titre-liste" class="visuellement-cache">Les annonces</h2>
    <div class="pa-colonnes" id="pa-liste">
      {agence && manchetteRencontres && (
        <article class="pa-agence" id="agence-valmorin" data-cat="rencontres">
          <img class="pa-agence-photo" src={lien(`annonces/${manchetteRencontres.image}`)} width="118" height="148" alt={manchetteRencontres.imageAlt} loading="lazy" />
          <div class="pa-agence-corps">
            <p class="pa-agence-etiquette">{agence.mention}</p>
            <h3>Agence « Rencontres &amp; affinités »</h3>
            <p class="pa-agence-texte">{manchetteRencontres.texte}</p>
            <a class="pa-agence-cta" href={lien(manchetteRencontres.lien)}>{manchetteRencontres.lienTexte} →</a>
          </div>
        </article>
      )}
      {premieres.map((a) => <AnnonceCarte a={a} />)}
    </div>
    <PubDefilante />
    <div class="pa-colonnes" id="pa-liste-2">
      {dernieres.map((a) => <AnnonceCarte a={a} />)}
    </div>
    <p class="pa-vide" id="pa-vide" hidden>Aucune annonce ne correspond à votre recherche. C'est sans doute la meilleure offre du jour.</p>
  </section>

  <aside class="pa-mention" role="note">{rubrique.mention} {rubrique.mentionReelle}</aside>
</Base>

<style is:global>
  .visuellement-cache { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pa-accroche { font: italic 1.25rem/1.4 var(--serif); margin: 4px 0 8px; }
  .pa-outils { margin: 18px 0 8px; font-family: var(--sans); }
  .pa-filtres { display: flex; flex-wrap: wrap; gap: 8px; }
  .pa-filtre { font: 600 .82rem var(--sans); padding: 7px 12px; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; }
  .pa-filtre:hover, .pa-filtre:focus-visible { background: var(--paper-2); }
  .pa-filtre[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .pa-n { font-weight: 400; opacity: .75; margin-left: 2px; }
  .pa-ligne { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 14px; }
  .pa-recherche { display: flex; align-items: center; gap: 8px; font-size: .85rem; }
  .pa-recherche input { font: .9rem var(--sans); padding: 7px 10px; border: 1.5px solid var(--ink); background: #fff; min-width: 220px; }
  .pa-compteur { margin: 0; font-size: .85rem; color: var(--ink-2); }
  .pa-depot { margin-left: auto; }
  .pa-depot summary { cursor: pointer; list-style: none; font: 700 .85rem var(--sans); padding: 8px 14px; border: 2px solid var(--accent); color: var(--accent); background: var(--paper); }
  .pa-depot summary::-webkit-details-marker { display: none; }
  .pa-depot[open] summary { background: var(--accent); color: #fff; }
  .pa-depot-corps { margin-top: 10px; padding: 14px 16px; border: 1px solid var(--rule); background: #fff; max-width: 640px; font-size: .9rem; line-height: 1.5; }
  .pa-form { display: grid; gap: 10px; margin-top: 8px; }
  .pa-form label { display: grid; gap: 4px; font-weight: 600; font-size: .85rem; }
  .pa-form input, .pa-form select, .pa-form textarea { font: .9rem var(--sans); padding: 7px 9px; border: 1.5px solid var(--ink); background: #fff; }
  .pa-form button { justify-self: start; font: 700 .9rem var(--sans); padding: 8px 16px; border: 2px solid var(--ink); background: var(--ink); color: var(--paper); cursor: pointer; }

  /* Colonnes de journal: les annonces s'ecoulent comme sur une page de petites annonces papier */
  /* Alignement: un seul rythme (--pa-gap entre annonces, --pa-pad dans les cadres) et un seul bord de texte: les cadres (vedette, encart) debordent dans la gouttiere */
  .pa-colonnes { --pa-gap: 22px; --pa-pad: 12px; column-width: 270px; column-gap: 40px; column-rule: 1px solid var(--rule); margin-top: 18px; }
  .pa { break-inside: avoid; margin: 0 0 var(--pa-gap); font-family: var(--serif); overflow-wrap: anywhere; }
  .pa[hidden], .pa-colonnes .pa[hidden] { display: none !important; } /* le filtre doit gagner sur les display: flex des encarts */
  .pa p { margin: 0; }
  .pa-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font: .66rem var(--sans); color: var(--ink-2); margin-bottom: 4px; }
  .pa-badge { font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .pa-titre { font: 700 calc(1.08rem * var(--k, 1))/1.25 var(--serif); margin: 0 0 4px; }
  .pa-prix { font: 700 calc(.95rem * var(--k, 1)) var(--sans); margin-bottom: 4px; }
  .pa-texte { font-size: calc(.96rem * var(--k, 1)); line-height: 1.5; }
  .pa-conditions { font: .72rem/1.4 var(--sans); color: var(--ink-2); margin-top: 6px; }
  .pa-annonceur { font: .72rem/1.4 var(--sans); color: var(--ink-2); margin-top: 6px; border-top: 1px dotted var(--rule); padding-top: 4px; }
  /* Drapeau arc-en-ciel LGBTQIA+ en filigrane: tres discret, derriere le texte, en bas a droite de l'annonce */
  .pa-contenu:has(.pa-drapeau) { position: relative; isolation: isolate; }
  .pa-drapeau { position: absolute; z-index: -1; right: 0; bottom: 0; width: 120px; height: 80px; opacity: .13; transform: rotate(-6deg); pointer-events: none; background: linear-gradient(#e40303 0 16.6%, #ff8c00 0 33.3%, #ffed00 0 50%, #008026 0 66.6%, #004dff 0 83.3%, #750787 0); }
  .pa-reel { font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #15803d; border: 1px solid #15803d; padding: 0 5px; }
  .pa-titre a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .pa-titre a:hover, .pa-titre a:focus-visible { text-decoration-thickness: 2px; color: var(--accent); }
  .pa-lien { margin-top: 8px !important; font: .8rem var(--sans); }
  .pa-lien a { font-weight: 700; color: var(--link); }
  .pa-lien span { color: var(--ink-2); font-size: .72rem; margin-left: 4px; }
  .pa-image { float: right; margin: 0 0 6px 10px; width: 112px; height: 112px; object-fit: contain; mix-blend-mode: multiply; } /* le fond blanc des photos d'objets disparait sur le papier */

  .pa-classique { padding-bottom: var(--pa-pad); border-bottom: 1px solid var(--rule); }
  .pa-court { padding: 0 0 var(--pa-pad); border-bottom: 1px dotted var(--ink); }
  .pa-court .pa-titre { display: inline; font-size: .95rem; text-transform: uppercase; letter-spacing: .02em; }
  .pa-court .pa-titre::after { content: ' — '; }
  .pa-court .pa-meta { margin-bottom: 2px; }
  .pa-court .pa-prix, .pa-court .pa-texte { display: inline; }
  .pa-court .pa-prix { margin: 0 4px 0 0; font-size: .85rem; }
  .pa-vedette { padding: var(--pa-pad); margin-left: calc(-1 * (var(--pa-pad) + 3px)); margin-right: calc(-1 * (var(--pa-pad) + 3px)); border: 3px double var(--ink); background: var(--paper-2); }
  .pa-vedette-bandeau { font: 800 .62rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: #fff; background: var(--accent); display: inline-block; padding: 2px 8px; margin-bottom: 6px; }
  .pa-vedette .pa-titre { font-size: 1.3rem; }
  .pa-vedette .pa-image { width: 136px; height: 136px; }

  /* Encarts publicitaires */
  .pa-encart { padding: var(--pa-pad); margin-left: calc(-1 * (var(--pa-pad) + 2px)); margin-right: calc(-1 * (var(--pa-pad) + 2px)); border: 2px solid currentColor; }
  .pa-marque { font: 800 .74rem var(--sans); letter-spacing: .18em; text-transform: uppercase; margin-bottom: 8px !important; padding-bottom: 6px; border-bottom: 1px solid currentColor; }
  .pa-encart .pa-titre { font-size: 1.2rem; }
  .pa-encart .pa-image { mix-blend-mode: normal; border: 2px solid var(--paper); background: var(--paper); object-fit: cover; }
  .pa-encart .pa-prix { display: inline-block; font-size: 1rem; padding: 3px 10px; margin: 2px 0 8px; background: var(--paper); color: var(--ink); }
  .pa-encart .pa-meta, .pa-encart .pa-ref { color: inherit; opacity: .85; }
  .pa-encart .pa-badge { color: inherit; }
  .pa-encart .pa-conditions { color: inherit; opacity: .9; font-size: .64rem; line-height: 1.35; }
  .pa-accroche-pub { font: italic 700 1.02rem/1.35 var(--serif); margin: 0 0 8px !important; }
  /* Logos: masques (cercle ou coins arrondis) cuits dans les images, affiches en entier (jamais rognes) */
  .pa-logo-fig { float: right; margin: -4px 0 8px 12px; width: 128px; text-align: center; }
  /* Placement du logo, different selon l'annonceur (champ logoStyle de config/annonces.json) */
  /* haut: grand logo centre au-dessus; texte justifie dessous (le logo est avant le texte dans le HTML) */
  .lg-haut .pa-logo-fig { float: none; width: auto; margin: 0 0 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, .35); }
  .pa-classique.lg-haut .pa-logo-fig { border-bottom-color: var(--rule); }
  .lg-haut .pa-logo { width: min(100%, 240px); max-height: 220px; }
  .lg-haut .pa-texte, .lg-haut .pa-conditions { text-align: justify; }
  /* encarts « haut »: l'accroche suit directement le logo, la reference passe tout en bas */
  .pa-encart.lg-haut { display: flex; flex-direction: column; }
  .pa-encart.lg-haut .pa-contenu { display: flex; flex-direction: column; }
  .pa-encart.lg-haut .pa-accroche-pub { order: 1; text-align: center; font-size: 1.12rem; }
  .pa-encart.lg-haut .pa-titre { order: 2; }
  .pa-encart.lg-haut .pa-prix { order: 3; align-self: flex-start; }
  .pa-encart.lg-haut .pa-texte { order: 4; }
  .pa-encart.lg-haut .pa-conditions { order: 5; }
  .pa-encart.lg-haut .pa-slogan { order: 6; }
  .pa-encart.lg-haut .pa-meta { order: 9; margin: 10px 0 0; padding-top: 6px; border-top: 1px solid rgba(255, 255, 255, .25); }
  /* duo: grand logo a gauche, titre et prix a sa droite (leur taille est accordee a celle du logo), le texte reprend sous le logo */
  .lg-duo .pa-logo-fig { float: left; width: 140px; margin: 0 14px 8px 0; padding: 0; border: 0; }
  .lg-duo .pa-logo { width: 140px; max-height: 140px; }
  .lg-duo .pa-titre { font-size: 1.2rem; line-height: 1.15; margin-top: 2px; overflow-wrap: normal; hyphens: auto; }
  .lg-duo .pa-prix { font-size: 1.1rem; }
  .lg-duo .pa-texte { font-size: 1.08rem; }
  .lg-duo > .pa-slogan { clear: both; }
  .lg-gauche .pa-logo-fig { float: left; margin: -2px 14px 8px 0; width: 112px; }
  .lg-gauche .pa-logo { width: 112px; }
  .lg-pied .pa-logo-fig { float: none; clear: both; display: flex; justify-content: flex-end; align-items: center; width: auto; margin: 10px 0 0; }
  .lg-pied .pa-logo { width: 84px; margin: 0; opacity: .95; }
  .lg-coin .pa-logo { width: 100px; }
  /* Grand logo en filigrane (transparence): inverse puis fondu dans le fond du cadre */
  .lg-filigrane { position: relative; overflow: hidden; }
  .lg-filigrane > *:not(.pa-filigrane) { position: relative; z-index: 1; }
  .pa-filigrane { position: absolute; z-index: 0; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 84%; height: auto; max-height: none; filter: invert(1) grayscale(1); mix-blend-mode: multiply; opacity: .3; pointer-events: none; }
  /* Texte des annonces justifie */
  .pa-texte, .pa-conditions { text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
  .pa-court .pa-texte { text-align: left; }
  /* Pas de justification a cote d'une image ou d'un logo flottant: la ligne est trop courte et laisse de grands blancs */
  .pa:has(.pa-image) .pa-texte, .pa:has(.pa-image) .pa-conditions, .pa:has(.pa-logo-fig) .pa-texte, .pa:has(.pa-logo-fig) .pa-conditions { text-align: left; }
  .pa-texte, .pa-conditions { hyphenate-limit-chars: 6 3 3; text-wrap: pretty; }
  .pa-logo { display: block; width: 128px; height: auto; max-height: 128px; object-fit: contain; margin: 0 auto; }
  .pa-logo-fig figcaption { margin-top: 4px; font: 800 .8rem var(--sans); letter-spacing: .04em; }
  /* Titre « facon soldes »: rouge, gras, defilant */
  .pa-solde { overflow: hidden; white-space: nowrap; background: #c8102e; border: 2px solid #c8102e; padding: 5px 0; margin: 0 0 6px !important; }
  .solde-texte { display: inline-block; color: #fff; font: 900 1.25rem/1.2 var(--sans); text-transform: uppercase; letter-spacing: .02em; padding-left: 100%; animation: solde-defile 11s linear infinite; }
  @keyframes solde-defile { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .solde-texte { animation: none; padding-left: 8px; white-space: normal; } .pa-solde { white-space: normal; } }
  /* L'agence partenaire: une annonce noire sur toute la largeur de la liste, bien en evidence */
  .pa-agence { column-span: all; display: grid; grid-template-columns: 118px 1fr; gap: 18px; align-items: center; margin: 0 0 26px; padding: 18px 22px; background: #0e0d0a; color: #faf7f2; border: 3px double #c89658; break-inside: avoid; }
  .pa-agence[hidden] { display: none; }
  .pa-agence-photo { width: 118px; height: 148px; object-fit: cover; object-position: 50% 12%; border: 2px solid #c89658; }
  .pa-agence-etiquette { margin: 0 0 4px; font: 800 .66rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: #e8c58f; }
  .pa-agence h3 { margin: 0 0 6px; font: 700 1.55rem/1.15 var(--serif); }
  .pa-agence-texte { margin: 0 0 12px; font: italic 1.08rem/1.45 var(--serif); }
  .pa-agence-cta { display: inline-block; padding: 8px 16px; background: #c89658; color: #0e0d0a; font: 800 .9rem var(--sans); text-decoration: none; border: 2px solid #c89658; }
  .pa-agence-cta:hover, .pa-agence-cta:focus-visible { background: transparent; color: #e8c58f; }
  @media (max-width: 560px) { .pa-agence { grid-template-columns: 1fr; text-align: center; } .pa-agence-photo { margin: 0 auto; } }
  /* Colonnes equilibrees (script): chaque annonce va dans la colonne la plus courte, puis la police des colonnes plus courtes grossit un peu
     pour que toutes finissent a la meme hauteur: aucun trou. Sans JavaScript, le repli est la mise en colonnes CSS ci-dessus. */
  .pa-colonnes.equilibre { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 40px; column-width: auto; column-rule: none; }
  .pa-colonnes.equilibre > .pa-agence { flex: 0 0 100%; }
  .pa-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .pa-col + .pa-col { position: relative; }
  .pa-col + .pa-col::before { content: ''; position: absolute; left: -20px; top: 0; bottom: 0; border-left: 1px solid var(--rule); }
  .pa-col > .pa:last-child { margin-bottom: 0; }
  .pa-slogan { font: italic .8rem var(--serif); margin-top: 8px !important; }
  .pal-ink { background: #16140f; color: #faf7f2; }
  .pal-bleu { background: #1c3a57; color: #f4f8fb; }
  .pal-vert { background: #1f4a2c; color: #f3f8f3; }
  .pal-rouge { background: #7a1a16; color: #fbf3f2; }
  .pal-or { background: #5c4310; color: #fbf3da; }

  .pa-vide { margin: 24px 0; font-style: italic; }
  .pa-mention { margin: 28px 0 0; padding: 10px 14px; border-top: 1px solid var(--rule); font: .78rem/1.5 var(--sans); color: var(--ink-2); text-align: center; }
  @media (max-width: 560px) { .pa-depot { margin-left: 0; width: 100%; } .pa-recherche input { min-width: 0; width: 100%; } .pa-recherche { width: 100%; } }
</style>

<script>
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const cartes = Array.from(document.querySelectorAll<HTMLElement>('.pa-colonnes .pa'));
  const agenceEl = document.getElementById('agence-valmorin');
  const pubDef = document.getElementById('pub-def');
  const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('.pa-filtre'));
  const champ = document.getElementById('pa-recherche') as HTMLInputElement;
  const compteur = document.getElementById('pa-compteur')!;
  const vide = document.getElementById('pa-vide')!;
  let cat = 'toutes';

  function filtre() {
    const q = norm(champ.value.trim());
    let n = 0;
    for (const c of cartes) {
      const ok = (cat === 'toutes' || c.dataset.cat === cat) && (!q || norm(c.dataset.texte ?? '').includes(q));
      c.hidden = !ok;
      if (ok) n++;
    }
    if (agenceEl) agenceEl.hidden = !(cat === 'toutes' && !q) && cat !== 'rencontres';
    if (pubDef) pubDef.hidden = cat !== 'toutes' || !!q; // la pub du milieu n'a de sens que sur la liste complete
    compteur.textContent = n + (n > 1 ? ' annonces' : ' annonce');
    vide.hidden = n > 0;
    if (typeof tout === 'function') tout();
  }
  for (const b of boutons) {
    b.addEventListener('click', () => {
      cat = b.dataset.cat!;
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      filtre();
    });
  }
  champ.addEventListener('input', filtre);

  // ---- equilibrage des colonnes ----
  const GAP = 40, MINW = 270;
  const listes = Array.from(document.querySelectorAll<HTMLElement>('.pa-colonnes')).map((l) => ({ l, cards: Array.from(l.querySelectorAll<HTMLElement>('.pa')) }));
  function equilibre({ l, cards }: { l: HTMLElement; cards: HTMLElement[] }) {
    const vieilles = Array.from(l.querySelectorAll<HTMLElement>(':scope > .pa-col'));
    const n = Math.min(3, Math.max(1, Math.floor((l.clientWidth + GAP) / (MINW + GAP))));
    for (const c of cards) c.parentElement?.style.removeProperty('--k');
    if (n < 2) {
      l.classList.remove('equilibre');
      cards.forEach((c) => l.append(c));
      vieilles.forEach((v) => v.remove());
      return;
    }
    l.classList.add('equilibre');
    const cols = Array.from({ length: n }, () => { const d = document.createElement('div'); d.className = 'pa-col'; return d; });
    l.append(...cols);
    const visibles = cards.filter((x) => !x.hidden);
    // 1) mesure: toutes les annonces dans la premiere colonne (meme largeur que les autres)
    cols[0].append(...visibles);
    const h = new Map(visibles.map((c) => [c, c.offsetHeight + 22]));
    // 2) repartition: les plus hautes d'abord dans la colonne la moins chargee, puis ameliorations par echanges/deplacements
    const charge = (i: number, aff: HTMLElement[][]) => aff[i].reduce((t, c) => t + h.get(c)!, 0);
    const aff: HTMLElement[][] = Array.from({ length: n }, () => []);
    for (const c of [...visibles].sort((x, y) => h.get(y)! - h.get(x)!)) {
      let m = 0;
      for (let i = 1; i < n; i++) if (charge(i, aff) < charge(m, aff)) m = i;
      aff[m].push(c);
    }
    const ecart = () => { const l = aff.map((_, i) => charge(i, aff)); return Math.max(...l) - Math.min(...l); };
    for (let tour = 0; tour < 200; tour++) {
      const avant = ecart();
      let meilleur: { x: number; y: number; i: number; j: number | null; e: number } | null = null;
      for (let x = 0; x < n; x++) for (let y = 0; y < n; y++) {
        if (x === y) continue;
        for (let i = 0; i < aff[x].length; i++) {
          const cx = aff[x][i];
          aff[x].splice(i, 1); aff[y].push(cx);
          let e = ecart(); if (e < (meilleur?.e ?? avant)) meilleur = { x, y, i, j: null, e };
          aff[y].pop(); aff[x].splice(i, 0, cx);
          for (let j = 0; j < aff[y].length; j++) {
            const cy = aff[y][j];
            aff[x][i] = cy; aff[y][j] = cx;
            e = ecart(); if (e < (meilleur?.e ?? avant)) meilleur = { x, y, i, j, e };
            aff[x][i] = cx; aff[y][j] = cy;
          }
        }
      }
      if (!meilleur) break;
      const { x, y, i, j } = meilleur;
      if (j === null) aff[y].push(aff[x].splice(i, 1)[0]);
      else { const t = aff[x][i]; aff[x][i] = aff[y][j]; aff[y][j] = t; }
    }
    // 3) ordre de lecture d'origine dans chaque colonne
    const rang = new Map(cards.map((c, i) => [c, i]));
    aff.forEach((liste, i) => cols[i].append(...liste.sort((x, y) => rang.get(x)! - rang.get(y)!)));
    cols[cols.length - 1].append(...cards.filter((x) => x.hidden)); // masquees (filtre): rangees sans effet sur la mise en page
    vieilles.forEach((v) => v.remove());
    const cible = Math.max(...cols.map((c) => c.offsetHeight));
    for (const col of cols) {
      let k = 1;
      while (k < 1.22) {
        const essai = Math.round((k + 0.01) * 100) / 100;
        col.style.setProperty('--k', String(essai));
        if (col.offsetHeight > cible) { col.style.setProperty('--k', String(k)); break; }
        k = essai;
      }
      // si le vide a combler est trop grand pour etre repartit entre les annonces sans que ce se voie, on laisse la colonne finir plus court
      const naturel = col.offsetHeight, nb = Math.max(col.children.length - 1, 1);
      if (cible - naturel > 28 * nb) { col.style.justifyContent = 'flex-start'; col.style.minHeight = ''; } else col.style.minHeight = cible + 'px';
    }
  }
  const tout = () => listes.forEach(equilibre);
  let t = 0;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(tout, 150); });
  window.addEventListener('load', tout);
  document.fonts?.ready.then(tout);
  // Liens profonds: ?cat=immobilier et ?q=chaise
  const params = new URLSearchParams(location.search);
  const catUrl = params.get('cat');
  if (catUrl) { const b = boutons.find((x) => x.dataset.cat === catUrl); if (b) b.click(); }
  if (params.get('q')) { champ.value = params.get('q')!; filtre(); }

  // Depot: pas de serveur. Le formulaire prepare un e-mail (mailto) que l'utilisateur envoie lui-meme; rien n'est enregistre ni publie.
  const form = document.getElementById('pa-form') as HTMLFormElement;
  const adresse = (document.querySelector('#pa-depot a[href^="mailto:"]') as HTMLAnchorElement).getAttribute('href')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const sujet = `[Petites annonces] ${d.get('titre')}`;
    const corps = `Catégorie : ${d.get('cat')}\nTitre : ${d.get('titre')}\nPrix : ${d.get('prix') || '(sans prix)'}\n\n${d.get('texte')}\n\n— Proposition d'annonce fictive et satirique, à relire avant toute publication.`;
    window.location.href = `${adresse}?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corps)}`;
  });
</script>
