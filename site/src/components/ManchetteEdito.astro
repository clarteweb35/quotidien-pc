---
// « La Manchette de la Manchette » : l'edito du jour (le plus recent) en gros titre, avec renvoi vers la page Editos.
import { allArticles, formatDate, url } from '../lib/site';
import { journalist, portrait } from '../lib/authors';
const edito = (await allArticles()).find((a) => a.data.category === 'editos');
const who = edito ? journalist(edito.data.author) : null;
const photo = who ? portrait(who.name) : null;
---
{edito && (
  <section class="mm" aria-labelledby="mm-etiquette">
    <p class="mm-etiquette" id="mm-etiquette">La Manchette de la Manchette</p>
    <div class="mm-corps">
      {photo && <img class="mm-photo" src={url(photo)} width="72" height="72" alt={`Portrait fictif de ${who!.name} (image générée par IA)`} />}
      <div>
        <h2 class="mm-titre"><a href={url(`articles/${edito.data.slug}/`)}>{edito.data.title}</a></h2>
        <p class="mm-chapo">{edito.data.chapo}</p>
        <p class="mm-pied">Édito du {formatDate(edito.data.publishedAt)}{who && <>, par {who.name}</>} · <a href={url('rubrique/editos/')}>Tous les éditos →</a></p>
      </div>
    </div>
  </section>
)}
<style>
  .mm { margin: 18px 0 6px; padding: 12px 18px 14px; border-top: 4px double var(--ink); border-bottom: 4px double var(--ink); background: linear-gradient(180deg, rgba(107, 33, 168, .07), transparent 70%); }
  .mm-etiquette { margin: 0 0 8px; font: 800 .72rem var(--sans); letter-spacing: .24em; text-transform: uppercase; color: #6b21a8; text-align: center; }
  .mm-corps { display: flex; gap: 16px; align-items: flex-start; }
  .mm-photo { flex: none; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid #6b21a8; }
  .mm-titre { margin: 0 0 6px; font: italic 700 clamp(1.5rem, 3.6vw, 2.3rem)/1.15 var(--serif); }
  .mm-titre a { color: var(--ink); text-decoration: none; }
  .mm-titre a:hover, .mm-titre a:focus-visible { text-decoration: underline; }
  .mm-chapo { margin: 0 0 6px; font-size: 1rem; line-height: 1.5; color: var(--ink-2); }
  .mm-pied { margin: 0; font: .8rem var(--sans); color: var(--ink-2); }
  .mm-pied a { color: var(--link); font-weight: 700; }
  @media (max-width: 520px) { .mm-corps { flex-direction: column; } }
</style>
