---
// Publicite fictive tiree des petites annonces (marquees "pub": true). Le HTML contient une annonce par defaut (choisie selon l'article, pour les
// lecteurs sans JavaScript); au chargement, le navigateur en tire une AUTRE au hasard parmi toutes. Le logo occupe toute la hauteur de la pub.
import { pubsCompactes } from '../lib/annonces';
import { url } from '../lib/site';
interface Props { seed: string }
const { seed } = Astro.props;
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const p = pubsCompactes.length ? pubsCompactes[h % pubsCompactes.length] : null;
const donnees = { base: url(''), pubs: pubsCompactes };
---
{p && (
  <aside class="pub" aria-label="Publicité fictive">
    <p class="pub-label">Publicité fictive · <a data-pub-lien href={url(`petites-annonces/#${p.id}`)}>Petites annonces</a></p>
    <div class="pub-corps">
      <figure class="pub-logo-fig" hidden={!p.logo}>
        <div class="pub-logo-zone"><img class="pub-logo" src={p.logo ? url(`annonces/${p.logo}`) : undefined} alt={p.marque ? `Logo de ${p.marque}` : ''} /></div>
        <figcaption class="pub-logo-legende" hidden={!(p.legende && p.marque)}>{p.marque}</figcaption>
      </figure>
      <div class="pub-texte-col">
        <p class="pub-marque" hidden={!p.marque || p.legende}>{p.marque}</p>
        <h3 class:list={['pub-titre', p.solde && 'pub-solde']}><span class="pub-titre-txt">{p.titre}</span></h3>
        <p class="pub-accroche" hidden={!p.accroche}>{p.accroche}</p>
        <p class="pub-prix" hidden={!p.prix}>{p.prix}</p>
        <p class="pub-texte">{p.texte}</p>
        <p class="pub-conditions" hidden={!p.conditions}>{p.conditions}</p>
        <p class="pub-lien"><a data-pub-lien href={url(`petites-annonces/#${p.id}`)}>Voir l'annonce →</a></p>
      </div>
    </div>
    <script type="application/json" id="pub-data" set:html={JSON.stringify(donnees)} />
  </aside>
)}
<script>
  const brut = document.getElementById('pub-data')?.textContent;
  const box = document.querySelector<HTMLElement>('.pub');
  if (brut && box) {
    const { base, pubs } = JSON.parse(brut) as { base: string; pubs: { id: string; marque: string; logo: string; legende: boolean; solde: boolean; titre: string; accroche: string; prix: string; texte: string; conditions: string }[] };
    const p = pubs[Math.floor(Math.random() * pubs.length)];
    const texte = (sel: string, v: string) => { const e = box.querySelector<HTMLElement>(sel); if (e) { e.textContent = v; e.hidden = !v; } };
    texte('.pub-marque', p.legende ? '' : p.marque); texte('.pub-titre-txt', p.titre); box.querySelector('.pub-titre')?.classList.toggle('pub-solde', p.solde);
    texte('.pub-accroche', p.accroche); texte('.pub-prix', p.prix); texte('.pub-texte', p.texte); texte('.pub-conditions', p.conditions);
    texte('.pub-logo-legende', p.legende ? p.marque : '');
    const fig = box.querySelector<HTMLElement>('.pub-logo-fig');
    const logo = box.querySelector<HTMLImageElement>('.pub-logo');
    if (fig && logo) { fig.hidden = !p.logo; if (p.logo) { logo.src = base + 'annonces/' + p.logo; logo.alt = 'Logo de ' + p.marque; } }
    box.querySelectorAll<HTMLAnchorElement>('a[data-pub-lien]').forEach((a) => { a.href = base + 'petites-annonces/#' + p.id; });
  }
</script>
<style>
  .pub { max-width: none; margin: 18px 0 18px; /* aussi large que le menu et le texte */ padding: 10px 14px 12px; border: 1px solid var(--ink); border-top: 3px double var(--ink); background: var(--paper-2); font-family: var(--sans); }
  .pub-label { margin: 0 0 8px; font: 700 .64rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }
  .pub-label a { color: inherit; }
  .pub-corps { display: flex; gap: 16px; align-items: stretch; }
  .pub-logo-fig { flex: none; width: 150px; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .pub-logo-zone { position: relative; flex: 1; width: 100%; min-height: 110px; }
  .pub-logo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .pub-logo-legende { font: 800 .8rem var(--sans); letter-spacing: .04em; text-align: center; }
  .pub-logo-fig[hidden], .pub [hidden] { display: none; }
  .pub-texte-col { flex: 1; min-width: 0; }
  .pub-marque { margin: 0; font: 800 .7rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .pub-titre { margin: 2px 0 4px; font: 700 1.1rem/1.25 var(--serif); }
  .pub-solde { overflow: hidden; white-space: nowrap; background: #c8102e; border: 2px solid #c8102e; padding: 5px 0; }
  .pub-solde .pub-titre-txt { display: inline-block; color: #fff; font: 900 1.2rem/1.2 var(--sans); text-transform: uppercase; padding-left: 100%; animation: pub-solde-defile 11s linear infinite; }
  @keyframes pub-solde-defile { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .pub-solde .pub-titre-txt { animation: none; padding-left: 8px; } .pub-solde { white-space: normal; } }
  .pub-accroche { margin: 0 0 4px; font: italic 700 .95rem var(--serif); }
  .pub-prix { margin: 0 0 4px; font-weight: 700; font-size: .9rem; }
  .pub-texte { margin: 0; font: .92rem/1.5 var(--serif); }
  .pub-conditions { margin: 4px 0 0; font-size: .68rem; color: var(--ink-2); line-height: 1.4; }
  .pub-lien { margin: 6px 0 0; font-size: .8rem; }
  .pub-lien a { color: var(--link); font-weight: 700; }
  @media (max-width: 520px) { .pub-logo-fig { width: 96px; } .pub-corps { gap: 10px; } }
</style>
