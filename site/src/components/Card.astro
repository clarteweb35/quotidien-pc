---
import { category, formatDate, url, manualImageCredit, type Article } from '../lib/site';
import { illustration } from '../lib/manual';
import { journalist, portrait } from '../lib/authors';
interface Props { article: Article; lead?: boolean }
const { article, lead = false } = Astro.props;
const d = article.data;
const cat = category(d.category);
const href = url(`articles/${d.slug}/`);
const who = journalist(d.author);
const img = await illustration(article, lead ? 1280 : 800, manualImageCredit);
const isEdito = d.category === 'editos';
const photo = who ? portrait(who.name) : null;
---
{isEdito && !lead ? (
  <article class="card edito">
    <p class="edito-etiquette"><a class="kicker" href={url(`rubrique/${cat.slug}/`)}>Édito</a></p>
    <div class="edito-tete">
      {photo && <img class="avatar avatar-md" src={url(photo)} width="64" height="64" alt={`Portrait fictif de ${who!.name} (image générée par IA)`} loading="lazy" />}
      <h3><a href={href}>{d.title}</a></h3>
    </div>
    <p>{d.chapo}</p>
    {who && <p class="byline">Par {who.name}, rédacteur en chef</p>}
    <div class="meta">{formatDate(d.publishedAt)}</div>
  </article>
) : lead ? (
  <article class:list={['lead', { 'no-media': !img }]}>
    <div>
      <a class="kicker" href={url(`rubrique/${cat.slug}/`)}>{cat.name}</a>
      <h2><a href={href}>{d.title}</a></h2>
      <p>{d.chapo}</p>
      {who && <p class="byline">Par {who.name}</p>}
      <div class="meta">{formatDate(d.publishedAt)}</div>
    </div>
    {img && <a href={href} tabindex="-1" aria-hidden="true"><img class="photo" src={img.src} srcset={img.srcset} sizes="(min-width: 1000px) 660px, 100vw" alt="" width={img.width} height={img.height} fetchpriority="high" /></a>}
  </article>
) : (
  <article class:list={['card', { 'no-media': !img }]}>
    {img ? <a href={href} tabindex="-1" aria-hidden="true"><img class="photo" src={img.src} srcset={img.srcset} sizes="(min-width: 1000px) 360px, 100vw" alt="" width={img.width} height={img.height} loading="lazy" /></a> : <a class="kicker" href={url(`rubrique/${cat.slug}/`)}>{cat.name}</a>}
    <h3><a href={href}>{d.title}</a></h3>
    <p>{d.chapo}</p>
    {who && <p class="byline">Par {who.name}</p>}
    <div class="meta">{formatDate(d.publishedAt)}</div>
  </article>
)}
