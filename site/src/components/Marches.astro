---
import { loadQuotes, marchesEnabled, fmtNum, quoteUrl, type Quote } from '../lib/marches';
const quotes = marchesEnabled ? await loadQuotes() : [];
const stamp = quotes.length ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(new Date(Math.max(...quotes.map((q) => q.time.getTime())))) : '';
const sign = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '');
const price = (q: Quote) => (q.kind === 'index' ? fmtNum(q.price, 0) : q.kind === 'fx' ? fmtNum(q.price, 4) : `${fmtNum(q.price)} ${q.currency === 'EUR' ? '€' : q.currency === 'USD' ? '$' : q.currency}`);
---
{quotes.length > 0 && (
  <section class="bandeau" aria-label="Cours des marchés (données réelles)">
    <div class="bd-head"><strong>Marchés</strong> <span>données réelles, hors satire</span></div>
    <ul class="bd-list">
      {quotes.map((q) => (
        <li class:list={[q.change > 0 && 'up', q.change < 0 && 'down']}>
          <a href={quoteUrl(q.symbol)} target="_blank" rel="noopener" title={`${q.label} sur Yahoo Finance`}>
            <span class="bd-name">{q.label}</span>
            <span class="bd-price">{price(q)}</span>
            <span class="bd-chg">{q.change > 0 ? '▲' : q.change < 0 ? '▼' : '■'} {sign(q.change)}{fmtNum(Math.abs(q.change))} %</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="bd-note">Cours différés au {stamp}, à titre indicatif ; liens vers la source. Ceci n'est pas un conseil en investissement.</p>
  </section>
)}
<style>
  .bandeau { margin: 16px 0 6px; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--rule); background: rgba(255,255,255,.45); font-family: var(--sans); }
  .bd-head { padding: 6px 10px 0; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .bd-head strong { color: var(--ink); }
  .bd-list { list-style: none; margin: 0; padding: 4px 4px 0; display: flex; flex-wrap: wrap; }
  .bd-list li { flex: 1 1 150px; border-left: 3px solid var(--rule); margin: 4px 6px; }
  .bd-list li.up { border-left-color: #15803d; } .bd-list li.down { border-left-color: #b3261e; }
  .bd-list a { display: grid; padding: 2px 8px; color: inherit; text-decoration: none; }
  .bd-list a:hover .bd-name { text-decoration: underline; }
  .bd-name { font-size: .72rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: .04em; }
  .bd-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  .bd-chg { font-size: .8rem; font-variant-numeric: tabular-nums; }
  .up .bd-chg { color: #15803d; } .down .bd-chg { color: #b3261e; }
  .bd-note { margin: 0; padding: 0 10px 6px; font-size: .72rem; color: var(--ink-2); }
</style>
