---
import { loadQuotes, marchesEnabled, fmtNum, quoteUrl, type Quote } from '../lib/marches';
// reverse: sens inverse du fil « A l'instant » (accueil). limit: nombre de valeurs affichees (l'accueil en garde peu, pour alleger la page: EcoIndex compte les elements du DOM).
interface Props { reverse?: boolean; limit?: number }
const { reverse = false, limit } = Astro.props;
const all = marchesEnabled ? await loadQuotes() : [];
const quotes = limit ? all.slice(0, limit) : all;
const stamp = all.length ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(new Date(Math.max(...all.map((q) => q.time.getTime())))) : '';
const sign = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '');
const price = (q: Quote) => (q.kind === 'index' ? fmtNum(q.price, 0) : q.kind === 'fx' ? fmtNum(q.price, 4) : `${fmtNum(q.price)} ${q.currency === 'EUR' ? '€' : q.currency === 'USD' ? '$' : q.currency}`);
---
{quotes.length > 0 && (
  <section class="bandeau" aria-label="Cours des marchés (données réelles)">
    <div class="bd-head"><strong>Marchés</strong> <span>données réelles, hors satire</span></div>
    <div class="bd-viewport">
      <div class:list={['bd-track', reverse && 'rev']}>
        {[0, 1].map((copy) => (
          <div class="bd-list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {quotes.map((q) => (
              <a class:list={['bd-item', q.change > 0 && 'up', q.change < 0 && 'down']} href={quoteUrl(q.symbol)} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined} title={`${q.label} sur Yahoo Finance`}>
                <span class="bd-name">{q.label}</span>
                <span class="bd-price">{price(q)}</span>
                <span class="bd-chg">{q.change > 0 ? '▲' : q.change < 0 ? '▼' : '■'} {sign(q.change)}{fmtNum(Math.abs(q.change))} %</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p class="bd-note">Cours différés au {stamp}, à titre indicatif ; liens vers la source. Ceci n'est pas un conseil en investissement.</p>
  </section>
)}
<style>
  .bandeau { margin: 16px 0 6px; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--rule); background: rgba(255,255,255,.45); font-family: var(--sans); }
  .bd-head { padding: 6px 10px 0; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .bd-head strong { color: var(--ink); }
  .bd-viewport { overflow: hidden; padding: 4px 0; }
  .bd-track { display: flex; width: max-content; animation: bd-scroll 60s linear infinite; }
  .bd-viewport:hover .bd-track, .bd-viewport:focus-within .bd-track { animation-play-state: paused; }
  .bd-track.rev { animation-direction: reverse; }
  .bd-list { display: flex; flex: none; }
  .bd-item { display: grid; flex: none; min-width: 150px; margin: 4px 14px; padding: 2px 8px; border-left: 3px solid var(--rule); color: inherit; text-decoration: none; }
  .bd-item.up { border-left-color: #15803d; } .bd-item.down { border-left-color: #b3261e; }
  .bd-item:hover .bd-name { text-decoration: underline; }
  @keyframes bd-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .bd-track { animation: none; } .bd-viewport { overflow-x: auto; } }
  .bd-name { font-size: .72rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: .04em; }
  .bd-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  .bd-chg { font-size: .8rem; font-variant-numeric: tabular-nums; }
  .up .bd-chg { color: #15803d; } .down .bd-chg { color: #b3261e; }
  .bd-note { margin: 0; padding: 0 10px 6px; font-size: .72rem; color: var(--ink-2); }
</style>
