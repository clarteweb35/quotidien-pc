---
import { loadQuotes, loadHeadlines, anniversary, marchesEnabled, fmtNum, type Quote } from '../lib/marches';
const quotes = marchesEnabled ? await loadQuotes() : [];
const headlines = marchesEnabled ? await loadHeadlines() : [];
const anniv = marchesEnabled ? anniversary() : null;
const stamp = quotes.length ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(new Date(Math.max(...quotes.map((q) => q.time.getTime())))) : '';
const sign = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '');
const price = (q: Quote) => (q.kind === 'index' ? fmtNum(q.price) + ' pts' : q.kind === 'fx' ? fmtNum(q.price, 4) : `${fmtNum(q.price)} ${q.currency === 'EUR' ? '€' : q.currency === 'USD' ? '$' : q.currency}`);
---
{(quotes.length > 0 || headlines.length > 0) && (
  <section class="marches" aria-label="Marchés et actualité économique">
    {quotes.length > 0 && (
      <div class="mk-quotes">
        <h2>Les marchés <span class="mk-sub">(les vrais chiffres, pour une fois)</span></h2>
        <ul class="mk-grid">
          {quotes.map((q) => (
            <li class:list={['mk-q', q.change > 0 && 'up', q.change < 0 && 'down']}>
              <span class="mk-name">{q.label}</span>
              <span class="mk-price">{price(q)}</span>
              <span class="mk-chg">{q.change > 0 ? '▲' : q.change < 0 ? '▼' : '■'} {sign(q.change)}{fmtNum(Math.abs(q.change))} %</span>
            </li>
          ))}
        </ul>
        <p class="meta">Cours différés, à titre indicatif, arrêtés au {stamp}. Ceci n'est pas un conseil en investissement.</p>
      </div>
    )}
    <div class="mk-side">
      {headlines.length > 0 && (
        <div class="mk-news">
          <h2>À lire ailleurs</h2>
          <ul>{headlines.map((h) => <li><a href={h.url} rel="noopener" target="_blank">{h.title}</a></li>)}</ul>
          <p class="meta">Titres du fil économie du Monde, avec lien vers la source.</p>
        </div>
      )}
      {anniv && (
        <div class="mk-history">
          <h2>Il y a {anniv.years} ans</h2>
          <p><strong>{anniv.date}.</strong> {anniv.text}</p>
        </div>
      )}
    </div>
  </section>
)}
<style>
  .marches { display: grid; grid-template-columns: 2fr 1fr; gap: 28px; margin: 22px 0 8px; padding-bottom: 22px; border-bottom: 1px solid var(--rule); }
  h2 { font-size: 1.15rem; margin: 0 0 10px; }
  .mk-sub { font: .78rem var(--sans); color: var(--ink-2); font-weight: 400; }
  .mk-grid { list-style: none; margin: 0 0 8px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .mk-q { display: grid; gap: 2px; padding: 10px 12px; border: 1px solid var(--rule); border-left: 4px solid var(--rule); background: rgba(255,255,255,.4); font-family: var(--sans); }
  .mk-q.up { border-left-color: #15803d; } .mk-q.down { border-left-color: #b3261e; }
  .mk-name { font-size: .74rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: .05em; }
  .mk-price { font-weight: 700; font-size: 1.02rem; font-variant-numeric: tabular-nums; }
  .mk-chg { font-size: .82rem; font-variant-numeric: tabular-nums; }
  .up .mk-chg { color: #15803d; } .down .mk-chg { color: #b3261e; }
  .mk-side { display: grid; gap: 22px; align-content: start; }
  .mk-news ul { margin: 0 0 6px; padding-left: 18px; font-size: .95rem; } .mk-news li { margin-bottom: 6px; }
  .mk-history { border-top: 3px solid var(--ink); padding-top: 8px; } .mk-history p { margin: 0; font-size: .95rem; }
  @media (max-width: 820px) { .marches { grid-template-columns: 1fr; } }
</style>
