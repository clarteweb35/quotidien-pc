---
// Bandeaux satiriques par rubrique. Tout est FICTIF et annoncé comme tel (pastille « Fiction »). Aucune donnée réelle, aucune requête réseau.
import { url } from '../lib/site';
// pill: pastille « Fiction », utile seulement quand du reel est affiche a cote (Economie, Sport, accueil, page Compteurs).
interface Props { slug: string; pill?: boolean }
const { slug, pill = false } = Astro.props;

// Générateur pseudo-aléatoire à graine (build) : même heure de build => mêmes valeurs.
const seeded = (seed: number) => () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const rnd = seeded(Math.floor(Date.now() / 3600000));

const prenoms = ['Maurice', 'Josette', 'Gérard', 'Huguette', 'Raymond', 'Odette', 'Roger', 'Ginette', 'Bernard', 'Colette', 'Jean-Claude', 'Yvette', 'Michel', 'Paulette', 'Fernand', 'Simone', 'Lucien', 'Monique', 'Gaston', 'Denise', 'Marcel', 'Jeannine', 'Albert', 'Micheline'];
const lettres = 'ABCDEFGHJKLMNPRSTV';
const villes = ['Vitré', 'Rennes', 'Domagné', 'Laval', 'Fougères', 'Nantes', 'Saint-Malo', 'Lorient', 'Angers', 'Le Mans', 'Cholet', 'Châteaubriant', 'Lille', 'Roubaix', 'Dijon', 'Limoges', 'Tarbes', 'Albi', 'Nîmes', 'Béziers', 'Saint-Étienne', 'Brive', 'Épinal', 'Charleville'];
// Plus de perdants que de gagnants: 2 sur 3 perdent (de 50 à 876 €), les autres gagnent de 3 à 58 €.
const eur = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const cents = () => Math.floor(rnd() * 100) / 100; // centimes systematiques
const pmu = Array.from({ length: 30 }, (_, i) => {
  const win = i % 3 === 1; // un gain toutes les trois lignes: jamais de longue serie de pertes, mais deux perdants pour un gagnant
  return {
    who: `${prenoms[Math.floor(rnd() * prenoms.length)]} ${lettres[Math.floor(rnd() * lettres.length)]}.`,
    ville: villes[Math.floor(rnd() * villes.length)],
    win,
    // Gains: souvent des miettes (0,10 a 2 €), parfois de 3 a 58 €.
    amount: win ? (rnd() < 0.45 ? Math.round((0.1 + rnd() * 1.9) * 100) / 100 : 3 + Math.floor(rnd() * 56) + cents()) : (rnd() < 0.8 ? 10 + Math.floor(rnd() * 89) : 99 + Math.floor(rnd() * 778)) + cents(), // pertes: surtout 10 a 98 €, parfois jusqu'a 876 €
  };
});

const capitales: [string, number][] = [['Paris', 14], ['Berne', 9], ['Oslo', 4], ['Madrid', 19], ['Tokyo', 17], ['Ottawa', 6], ['Canberra', 23], ['Nairobi', 24], ['Lima', 20], ['Reykjavik', 3], ['Le Caire', 28], ['Wellington', 13], ['Brasilia', 26], ['Vienne', 8], ['Hanoï', 27], ['Dublin', 10]];
const icones = ['☀️', '⛅', '☁️', '🌧️', '⛈️', '❄️', '🌪️', '🌈', '🐴', '🍹'];
---
{slug === 'economie' && (
  <section class="gm gm-pmu" aria-label="Gains et pertes PMU du jour (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Gains et pertes PMU du jour</strong><span class="gm-note">noms, villes et montants bidon</span></div>
    <div class="gm-viewport"><div class="gm-track">
      {[0, 1].map((copy) => (
        <ul class="gm-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {pmu.map((g) => <li><b>{g.who}</b> ({g.ville}) {g.win ? 'gains de' : 'perte de'}{' '}<span class={g.win ? 'gm-gain' : 'gm-loss'}>{eur(g.amount)} €</span></li>)}
        </ul>
      ))}
    </div></div>
  </section>
)}

{slug === 'politique' && (
  <section class="gm gm-regle" aria-label="Règle de tweets favorables (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Part de tweets favorables</strong><span class="gm-note">sondage de <span data-gm="question">la question 145-B du 13 avril</span> (sujet non communiqué) · résultats bidon</span></div>
    <div class="regle" data-gm="regle">
      <div class="regle-bar"><div class="regle-cursor" style="left:50%"><span class="regle-val">50,0 %</span></div></div>
      <div class="regle-scale"><span>0</span><span>25</span><span>50</span><span>75</span><span>100</span></div>
    </div>
  </section>
)}

{slug === 'monde' && (
  <section class="gm gm-meteo" aria-label="Météo des capitales (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Météo des capitales</strong><span class="gm-note">températures inventées</span></div>
    <div class="gm-viewport"><div class="gm-track">
      {[0, 1].map((copy) => (
        <ul class="gm-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {capitales.map(([nom, t], i) => <li data-gm="cap" data-t={t}><b>{nom}</b> <span class="cap-ico">{icones[(i * 3) % icones.length]}</span> <span class="cap-t">{t} °C</span></li>)}
        </ul>
      ))}
    </div></div>
  </section>
)}

{slug === 'environnement' && (
  <section class="gm gm-compteur" aria-label="Compteur de forêt amazonienne rasée (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Forêt amazonienne rasée depuis minuit</strong><span class="gm-note">estimation inventée, remise à zéro à minuit</span></div>
    <p class="compteur"><span data-gm="counter" data-mode="day" data-lo="1.2" data-hi="3.2" data-dec="1">0</span> <abbr title="hectares">ha</abbr></p>
  </section>
)}

{slug === 'culture' && (
  <section class="gm gm-compteur" aria-label="Compteur d'heures de chômage des intermittents (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Heures de chômage à indemniser aux intermittents ce mois-ci</strong><span class="gm-note">chiffre inventé, remis à zéro le 1<sup>er</sup> du mois</span></div>
    <p class="compteur"><span data-gm="counter" data-mode="month" data-lo="3" data-hi="7" data-dec="0">0</span> <abbr title="heures">h</abbr></p>
  </section>
)}

{slug === 'societe' && (
  <>
    <section class="gm" aria-label="Attente à la préfecture (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Attente moyenne à la préfecture</strong><span class="gm-note">chiffre inventé · guichets ouverts de 9 h 30 à 11 h 30 et de 14 h à 16 h 30, sinon 0</span></div>
      <p class="compteur"><span data-gm="attente">3 h 12</span> <small data-gm="attente-etat"></small></p>
    </section>
    <section class="gm" aria-label="Réunions qui auraient pu être un e-mail (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Réunions d'aujourd'hui qui auraient pu être un e-mail</strong><span class="gm-note">remis à zéro à minuit</span></div>
      <p class="compteur"><span data-gm="counter" data-mode="day" data-lo="0.01" data-hi="0.05" data-dec="0">0</span></p>
    </section>
  </>
)}

{slug === 'tech' && (
  <>
    <section class="gm" aria-label="Statut des serveurs (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Statut des serveurs</strong></div>
      <p class="statut"><span class="statut-pastille" data-gm="statut-pastille"></span><span data-gm="statut-texte">Tout fonctionne (probablement)</span></p>
    </section>
    <section class="gm" aria-label="Mise à jour en cours (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Mise à jour en cours</strong><span class="gm-note" data-gm="maj-texte">1 % — plus que quelques minutes</span></div>
      <div class="maj"><div class="maj-barre" data-gm="maj-barre" style="width:1%"></div></div>
    </section>
  </>
)}

{slug === 'sport' && (
  <>
    <section class="gm" aria-label="C'est la faute à l'arbitre (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>« C'est la faute à l'arbitre » depuis minuit</strong><span class="gm-note">remis à zéro à minuit</span></div>
      <p class="compteur"><span data-gm="counter" data-mode="day" data-lo="0.005" data-hi="0.03" data-dec="0">0</span></p>
    </section>
    <section class="gm" aria-label="Chrono d'après-match (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Temps écoulé depuis le dernier « on a manqué de réussite »</strong></div>
      <p class="compteur"><span data-gm="chrono">00:00:00</span></p>
    </section>
  </>
)}

{slug === 'culture' && (
  <>
    <section class="gm" aria-label="Bande-annonce (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Bande-annonce permanente</strong><span class="gm-note">film inventé, nouveau à chaque chargement</span></div>
      <p class="trailer"><em>Dans un monde…</em> <strong data-gm="trailer">Le Retour du Retour</strong></p>
    </section>
    <section class="gm" aria-label="Lu ou acheté (fiction)">
      <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>« Je l'ai lu » contre « Je l'ai acheté »</strong><span class="gm-note">pourcentages inventés</span></div>
      <p class="livre"><em data-gm="livre-titre">« Les Vacances du Rond-point »</em> de <strong data-gm="livre-auteur">Gérard Plumeau</strong></p>
      <div class="duel" data-gm="duel">
        <div class="duel-ligne"><span>Je l'ai acheté</span><div class="duel-piste"><div class="duel-barre achete" style="width:92%"></div></div><b data-gm="duel-achete">92 %</b></div>
        <div class="duel-ligne"><span>Je l'ai lu</span><div class="duel-piste"><div class="duel-barre lu" style="width:11%"></div></div><b data-gm="duel-lu">11 %</b></div>
      </div>
    </section>
  </>
)}

{slug === 'accueil' && (
  <section class="gm" aria-label="Prévision et horoscope (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Demain, en une ligne</strong></div>
    <p class="une-ligne" data-gm="prevision">À peu près pareil, mais en pire ou en mieux.</p>
    <div class="gm-head gm-head-bas"><strong>Horoscope de la rédaction</strong><span class="gm-note" data-gm="signe">Balance</span></div>
    <p class="une-ligne" data-gm="horoscope">Aujourd'hui, un dossier avancera sans vous.</p>
  </section>
)}

{slug === 'redaction' && (
  <section class="gm" aria-label="Cafés de Lucas (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Cafés préparés par Lucas aujourd'hui</strong><span class="gm-note">dont <span data-gm="buvables">0</span> buvable(s)</span></div>
    <p class="compteur cafe"><img class="cafe-tete" src={url('redaction/lucas-dumond.webp')} width="48" height="48" alt="Lucas D., préposé au café" loading="lazy" /><span data-gm="counter" data-mode="day" data-lo="0.003" data-hi="0.012" data-dec="0">0</span></p>
  </section>
)}

{slug === 'mentions' && (
  <section class="gm" aria-label="Lecture des mentions légales (fiction)">
    <div class="gm-head">{pill && <span class="gm-pill">Fiction</span>}<strong>Avez-vous lu les mentions légales ?</strong></div>
    <div class="lu-zone" data-gm="lu-zone"><button type="button" class="lu-bouton" data-gm="lu-bouton">J'ai lu les mentions légales</button><span class="lu-retour" data-gm="lu-retour" role="status"></span></div>
  </section>
)}

<script>
  const paris = () => {
    const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: false }).formatToParts(new Date()).map((x) => [x.type, +x.value]));
    return { y: p.year, m: p.month, d: p.day, h: p.hour % 24, min: p.minute, s: p.second };
  };
  const rng = (seed: number) => { let t = (seed + 0x6d2b79f5) | 0; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };

  // Compteurs (jour ou mois) : cumul d'un débit par minute pseudo-aléatoire mais déterministe => même valeur pour tous, remise à zéro à minuit / le 1er.
  document.querySelectorAll<HTMLElement>('[data-gm="counter"]').forEach((el) => {
    const lo = +el.dataset.lo!, hi = +el.dataset.hi!, dec = +el.dataset.dec!, month = el.dataset.mode === 'month';
    const fmt = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    const tick = () => {
      const t = paris();
      const n = (month ? (t.d - 1) * 1440 : 0) + t.h * 60 + t.min;
      const base = t.y * 10000 + t.m * 100 + (month ? 0 : t.d);
      let sum = 0;
      for (let i = 0; i < n; i++) sum += lo + (hi - lo) * rng(base * 100000 + i);
      sum += (lo + (hi - lo) * rng(base * 100000 + n)) * (t.s / 60);
      el.textContent = fmt.format(sum);
    };
    tick(); setInterval(tick, 1000);
  });

  // Règle de tweets favorables (bidon) : le curseur bouge de temps en temps (toutes les 5 à 11 s) ; la question du sondage change à chaque chargement de la page.
  const mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
  const pick = (n: number) => Math.floor(Math.random() * n);
  document.querySelectorAll<HTMLElement>('[data-gm="regle"]').forEach((el) => {
    const cursor = el.querySelector<HTMLElement>('.regle-cursor')!, val = el.querySelector<HTMLElement>('.regle-val')!;
    const question = document.querySelector<HTMLElement>('[data-gm="question"]');
    // La question du sondage ne change qu'au chargement de la page.
    if (question) question.textContent = `la question ${1 + pick(399)}-${'ABCDEF'[pick(6)]} du ${1 + pick(28)} ${mois[pick(12)]}`;
    let v = 50;
    const fmt = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const step = () => {
      v += (50 - v) * 0.15 + (Math.random() - 0.5) * 40;
      v = Math.min(94, Math.max(6, v));
      cursor.style.left = v + '%';
      cursor.classList.toggle('flip', v > 70);
      val.textContent = fmt.format(v) + ' %';
      setTimeout(step, 5000 + Math.random() * 6000);
    };
    step();
  });

  // Météo des capitales : icône et température qui changent.
  const icones = ['☀️', '⛅', '☁️', '🌧️', '⛈️', '❄️', '🌪️', '🌈'];
  // De temps en temps, une icone qui n'a rien a voir avec la meteo.
  const absurdes = ['🐴', '🍹', '🦆', '🧀', '🚲', '🎺', '🥐', '🛸', '🐌', '🍕', '🦕', '🪑'];
  const caps = document.querySelectorAll<HTMLElement>('[data-gm="cap"]');
  if (caps.length) {
    // Les icones et temperatures ne changent jamais sous les yeux du visiteur: seulement quand la capitale est hors de l'ecran (defilement).
    const visibles = new Set<Element>();
    const io = new IntersectionObserver((entrees) => entrees.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target))));
    caps.forEach((li) => io.observe(li));
    setInterval(() => {
      caps.forEach((li) => {
        if (visibles.has(li)) return;
        if (Math.random() < 0.5) {
          const liste = Math.random() < 0.22 ? absurdes : icones;
          li.querySelector('.cap-ico')!.textContent = liste[Math.floor(Math.random() * liste.length)];
          const t = +li.dataset.t! + Math.round((Math.random() - 0.5) * 8);
          li.querySelector('.cap-t')!.textContent = t + ' °C';
        }
      });
    }, 2500);
  }

  // Attente a la prefecture: remonte toute seule, retombe d'un coup de temps en temps; 0 hors des heures d'ouverture (Paris).
  document.querySelectorAll<HTMLElement>('[data-gm="attente"]').forEach((el) => {
    const etat = document.querySelector<HTMLElement>('[data-gm="attente-etat"]');
    let min = 192;
    const ouvert = () => {
      const t = paris(), m = t.h * 60 + t.min;
      return (m >= 570 && m < 690) || (m >= 840 && m < 990);
    };
    const show = () => {
      const o = ouvert();
      el.textContent = o ? Math.floor(min / 60) + ' h ' + String(Math.round(min % 60)).padStart(2, '0') : '0';
      if (etat) etat.textContent = o ? '' : '(guichets fermés)';
    };
    show();
    setInterval(() => { min = Math.random() < 0.08 ? 40 + Math.random() * 60 : Math.min(340, min + 1 + Math.random() * 4); show(); }, 3500);
  });

  // Statut des serveurs: parfois orange, quelques secondes.
  document.querySelectorAll<HTMLElement>('[data-gm="statut-pastille"]').forEach((pastille) => {
    const texte = document.querySelector<HTMLElement>('[data-gm="statut-texte"]')!;
    const etats = [['Redémarrage en cours…', 'orange'], ['Quelqu\'un a débranché quelque chose', 'orange'], ['Tout fonctionne (probablement)', 'vert']];
    const boucle = () => {
      const [t, c] = Math.random() < 0.35 ? etats[Math.floor(Math.random() * 2)] : etats[2];
      texte.textContent = t; pastille.dataset.etat = c;
      setTimeout(boucle, c === 'vert' ? 6000 + Math.random() * 6000 : 3500);
    };
    boucle();
  });

  // Mise a jour: monte jusqu'a 99 % et y reste.
  document.querySelectorAll<HTMLElement>('[data-gm="maj-barre"]').forEach((barre) => {
    const texte = document.querySelector<HTMLElement>('[data-gm="maj-texte"]')!;
    let v = 1;
    const id = setInterval(() => {
      v = Math.min(99, v + 1 + Math.random() * 5);
      barre.style.width = v + '%';
      if (v >= 99) { texte.textContent = '99 % — plus que quelques minutes'; clearInterval(id); }
      else texte.textContent = Math.round(v) + ' % — plus que quelques minutes';
    }, 500);
  });

  // Chrono d'apres-match: repart de zero a chaque « manque de reussite » (30 a 90 s).
  document.querySelectorAll<HTMLElement>('[data-gm="chrono"]').forEach((el) => {
    let t = 0, limite = 30 + Math.random() * 60;
    const f = (n: number) => String(n).padStart(2, '0');
    setInterval(() => { t++; if (t > limite) { t = 0; limite = 30 + Math.random() * 60; } el.textContent = '00:' + f(Math.floor(t / 60)) + ':' + f(t % 60); }, 1000);
  });

  // Bande-annonce: un titre inventé par chargement.
  document.querySelectorAll<HTMLElement>('[data-gm="trailer"]').forEach((el) => {
    const a = ['Le Retour du', 'La Vengeance du', 'Le Dernier', 'L\'Ultime', 'La Revanche du', 'Le Secret du'];
    const b = ['Retour', 'Brouillon', 'Ascenseur', 'Rond-point', 'Tableur', 'Voisin', 'Pot de départ', 'Photocopieur'];
    el.textContent = a[Math.floor(Math.random() * a.length)] + ' ' + b[Math.floor(Math.random() * b.length)];
  });

  // Livre et auteur bidon, differents a chaque chargement.
  const livreTitre = document.querySelector<HTMLElement>('[data-gm="livre-titre"]');
  const livreAuteur = document.querySelector<HTMLElement>('[data-gm="livre-auteur"]');
  if (livreTitre && livreAuteur) {
    const un = <T,>(l: T[]) => l[Math.floor(Math.random() * l.length)];
    const debuts = ['Les Vacances du', 'Le Silence du', 'Mémoires d’un', 'La Dernière Réunion du', 'Petit Traité du', 'L’Ascension du', 'Le Journal intime d’un', 'Voyage au bout du'];
    const fins = ['Rond-point', 'Photocopieur', 'Tableur', 'Parapluie', 'Ascenseur', 'Voisin du dessus', 'Pot de départ', 'Code postal', 'Lundi matin'];
    const prenoms = ['Gérard', 'Odile', 'Anselme', 'Bérengère', 'Hippolyte', 'Prudence', 'Octave', 'Clotilde'];
    const noms = ['Plumeau', 'Marmelade', 'Bouchardon', 'Cornichon', 'Tapioca', 'Boulanger-Lenteur', 'Pastèque', 'Gribouille'];
    livreTitre.textContent = '« ' + un(debuts) + ' ' + un(fins) + ' »';
    livreAuteur.textContent = un(prenoms) + ' ' + un(noms);
  }

  // Lu / acheté: l'écart bouge un peu de temps en temps.
  document.querySelectorAll<HTMLElement>('[data-gm="duel"]').forEach((el) => {
    const set = (sel: string, v: number, txt: string) => { el.querySelector<HTMLElement>(sel)!.style.width = v + '%'; document.querySelector(txt)!.textContent = Math.round(v) + ' %'; };
    const boucle = () => { set('.achete', 86 + Math.random() * 12, '[data-gm="duel-achete"]'); set('.lu', 6 + Math.random() * 12, '[data-gm="duel-lu"]'); setTimeout(boucle, 6000 + Math.random() * 5000); };
    boucle();
  });

  // Accueil: previsions et horoscope, une phrase par chargement.
  const choix = <T,>(l: T[]) => l[Math.floor(Math.random() * l.length)];
  const prev = document.querySelector<HTMLElement>('[data-gm="prevision"]');
  if (prev) prev.textContent = choix(['À peu près pareil, mais en pire ou en mieux.', 'Quelques éclaircies, sous réserve de nuages.', 'Il fera le temps qu\'il fera, avec une marge d\'erreur confortable.', 'Probablement demain.', 'Variable, comme les promesses.']);
  const signe = document.querySelector<HTMLElement>('[data-gm="signe"]');
  const horo = document.querySelector<HTMLElement>('[data-gm="horoscope"]');
  if (signe && horo) {
    signe.textContent = choix(['Bélier', 'Taureau', 'Gémeaux', 'Cancer', 'Lion', 'Vierge', 'Balance', 'Scorpion', 'Sagittaire', 'Capricorne', 'Verseau', 'Poissons']);
    horo.textContent = choix(['Aujourd\'hui, un dossier avancera sans vous.', 'Une réunion tombera à l\'eau, un café aussi.', 'Vous aurez raison, mais pas au bon moment.', 'Un collègue vous dira « tu as vu mon mail ? ». Non.', 'Jour idéal pour reporter à demain.']);
  }

  // Cafes de Lucas: quelques-uns seulement sont buvables.
  document.querySelectorAll<HTMLElement>('[data-gm="buvables"]').forEach((el) => {
    const n = Number(el.closest('section')?.querySelector('[data-gm="counter"]')?.textContent?.replace(/\D/g, '') || 0);
    el.textContent = String(Math.floor(n / 9));
  });

  // Bouton « J'ai lu les mentions legales »: il esquive la souris (jamais le clavier), puis se laisse cliquer.
  document.querySelectorAll<HTMLElement>('[data-gm="lu-bouton"]').forEach((btn) => {
    const retour = document.querySelector<HTMLElement>('[data-gm="lu-retour"]')!;
    let esquives = 0;
    btn.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse' || esquives >= 4) return;
      esquives++;
      btn.style.transform = 'translate(' + Math.round((Math.random() - 0.5) * 160) + 'px,' + Math.round((Math.random() - 0.5) * 30) + 'px)';
    });
    btn.addEventListener('click', () => { retour.textContent = 'Merci. Nous ne vous croyons pas.'; btn.style.transform = 'none'; });
  });
</script>

