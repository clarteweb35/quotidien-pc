---
import '../styles/global.css';
import { categories, siteName, tagline, logoName, url } from '../lib/site';
import editorial from '../../../config/editorial.json';
import { publisher, analyticsId } from '../lib/legal';
import Consent from '../components/Consent.astro';
import ManchetteEdito from '../components/ManchetteEdito.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
    manchette?: boolean; // La derniere manchette de la Manchette sous le menu (absente de la redaction, des petites annonces, des rencontres et des jeux)
  follow?: boolean; // avec noindex: laisser les robots suivre les liens (pages minces, ex. mots-cles)
  current?: string;
  jsonLd?: object;
  csp?: string;
  ogImage?: string;
}
const { title, description = tagline, type = 'website', noindex = false, follow = false, manchette = true, current = '', jsonLd, csp, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = new URL(ogImage ?? url('brand/og-default.png'), Astro.site).toString();
// Mesures de qualite du site (a mettre a jour a chaque nouvelle mesure: ne jamais afficher un score non verifie).
const qualityDate = 'les 25 et 26 octobre 2026'; // EcoIndex le 26 (B, 80/100), Website Carbon et PageSpeed le 25
const quality = [
  { name: 'EcoIndex', score: 'B', url: 'https://www.ecoindex.fr/resultat/?id=e6232d45-39cc-4b3a-baa7-46e269f2041c' },
  { name: 'Website Carbon', score: 'A', url: 'https://www.websitecarbon.com/website/quotidien-pc-fr/' },
  { name: 'PageSpeed Insights', score: '100', url: 'https://pagespeed.web.dev/analysis/https-quotidien-pc-fr/m5tdao3js7?form_factor=mobile' },
];
// Menu: entrees dans l'ordre; chaque entree se « tape » a la suite de la precedente (voir .nav a dans global.css).
const MENU = [
  { href: url(), label: 'À la une', cle: 'home', rang: 'une' },
  ...categories.filter((c) => c.menuTete).map((c) => ({ href: url(`rubrique/${c.slug}/`), label: c.name, cle: c.slug, rang: 'tete' })),
  ...categories.filter((c) => !c.menuTete).map((c) => ({ href: url(`rubrique/${c.slug}/`), label: c.name, cle: c.slug })),
  // Trois onglets de meme taille, bleu / blanc / rouge: le drapeau francais
  { href: url('petites-annonces/'), label: 'Petites annonces', cle: 'annonces', onglet: 'bleu' },
  { href: url('rencontres/'), label: 'Rencontres', cle: 'rencontres', onglet: 'blanc' },
  { href: url('jeux/'), label: 'Jeux', cle: 'jeux', onglet: 'rouge' },
];
const SEC_PAR_LETTRE = 0.02;
let cumul = 0.25;
const menuFrappe = MENU.map((m) => { const o = { ...m, n: m.label.length, t: Number(cumul.toFixed(2)) }; cumul += m.label.length * SEC_PAR_LETTRE; return o; });
// Barre du bas (mobile, facon France 24): quelques entrees rapides + « Menu » qui ouvre le menu complet
const rapides = menuFrappe.filter((m) => ['home', 'editos', 'annonces', 'jeux'].includes(m.cle));
const menuFin = Number(cumul.toFixed(2));
// Decomptes affiches sous le logo (J-): jours calendaires a l'heure de Paris. Valeur du build, recalculee dans le navigateur.
const parisYmd = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris' }).format(d);
const jours = (cible: string) => Math.round((Date.parse(cible) - Date.parse(parisYmd(new Date()))) / 864e5);
const dc = editorial.decomptes;
const ajd = parisYmd(new Date());
const noelCible = (() => { const a = Number(ajd.slice(0, 4)); const n = `${a}-${String(dc.noelMois).padStart(2, '0')}-${String(dc.noelJour).padStart(2, '0')}`; return n >= ajd ? n : `${a + 1}${n.slice(4)}`; })();
const jPresidentielle = jours(dc.presidentielle);
const jNoel = jours(noelCible);
const today = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', dateStyle: 'full' }).format(new Date());
---
<!doctype html>
<html lang="fr">
  <head>
    <script is:inline set:html={`try{if(location.pathname.replace(/index\.html$/,"")!=="${url()}"||localStorage.getItem("frappe"))document.documentElement.classList.add("sans-frappe");else localStorage.setItem("frappe","1")}catch(e){}`}></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    {noindex && <meta name="robots" content={follow ? 'noindex, follow' : 'noindex, nofollow'} />}
    <link rel="alternate" type="application/rss+xml" title={siteName} href={url('rss.xml')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={share} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={share} />
    <meta name="theme-color" content="#faf7f2" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <div class="strip">Journal satirique — tout ce que vous lisez ici est faux, sauf l'envie de rire</div>
    <header class="wrap masthead">
      <a href={url()} aria-label={`${siteName} — retour à la une`}>
        <picture>
          <source srcset={`${url('brand/logo-720.webp')} 720w, ${url('brand/logo-1100.webp')} 1100w`} sizes="(min-width: 760px) 721px, 100vw" type="image/webp" />
          <img class="logo" src={url('brand/logo-1100.png')} width="1100" height="367" alt={`${logoName.main} ${logoName.sub.toLowerCase()} — ${tagline}`} fetchpriority="high" />
        </picture>
      </a>
      <p class="date"><span id="today">{today}</span><span id="clock"></span><span class="decomptes">{jPresidentielle >= 0 && <> · <span id="jp" data-d={dc.presidentielle}>J-{jPresidentielle} avant la présidentielle</span></>} · <span id="jn" data-m={dc.noelMois} data-j={dc.noelJour}>J-{jNoel} avant Noël</span></span></p>
      <script is:inline set:html={`(function(){var c=document.getElementById("clock");if(!c)return;var f=new Intl.DateTimeFormat("fr-FR",{timeZone:"Europe/Paris",hour:"2-digit",minute:"2-digit"});var p=new Intl.DateTimeFormat("en-CA",{timeZone:"Europe/Paris"});function n(s){return Date.parse(s)}function d2(m){return String(m).padStart(2,"0")}function k(){var a=p.format(new Date()),jp=document.getElementById("jp"),jn=document.getElementById("jn");if(jp){var x=Math.round((n(jp.dataset.d)-n(a))/864e5);jp.textContent=x>=0?"J-"+x+" avant la présidentielle":"";}if(jn){var y=a.slice(0,4),z=y+"-"+d2(jn.dataset.m)+"-"+d2(jn.dataset.j);if(z<a)z=(+y+1)+z.slice(4);jn.textContent="J-"+Math.round((n(z)-n(a))/864e5)+" avant Noël"}}function t(){c.textContent=" · "+f.format(new Date()).replace(":"," h ");k()}t();setInterval(t,15000)})()`}></script>
    </header>
    <nav class="nav" id="nav-principal" aria-label="Rubriques" style={`--fin:${menuFin}s`}>
      <div class="wrap">
        <ul>
          {menuFrappe.map((m) => (
            <li class={m.onglet ? `onglet-li onglet-${m.onglet}` : undefined} style={`--n2:${m.n};--t2:${m.t}s`}><a class={m.onglet ? 'onglet' : m.rang ? `rang-${m.rang}` : undefined} href={m.href} style={`--n:${m.n};--t:${m.t}s`} aria-current={current === m.cle ? 'page' : undefined}>{m.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <div class="barre-bas">
      {rapides.map((m) => <a href={m.href} aria-current={current === m.cle ? 'page' : undefined}>{m.cle === 'home' ? 'À la une' : m.cle === 'annonces' ? 'Annonces' : m.label}</a>)}
      <button type="button" id="barre-menu" aria-expanded="false" aria-controls="nav-principal"><span class="traits" aria-hidden="true"></span>Menu</button>
    </div>
    <script is:inline set:html={`(function(){var b=document.getElementById("barre-menu"),h=document.documentElement;if(!b)return;function s(o){h.classList.toggle("menu-ouvert",o);b.setAttribute("aria-expanded",o?"true":"false")}b.addEventListener("click",function(){s(!h.classList.contains("menu-ouvert"))});document.addEventListener("keydown",function(e){if(e.key==="Escape")s(false)});document.getElementById("nav-principal").addEventListener("click",function(e){if(e.target.closest("a"))s(false)});document.addEventListener("click",function(e){if(h.classList.contains("menu-ouvert")&&!e.target.closest("#nav-principal,#barre-menu"))s(false)})})()`}></script>
    {!csp && !noindex && manchette && (
      <div class="wrap manchette-globale"><ManchetteEdito /></div>
    )}
    <main id="contenu" class="wrap"><slot /></main>
    <footer>
      <div class="wrap cols">
        <div class="brand">
          <a class="wordmark" href={url()}><b>{logoName.main}</b><i>{logoName.sub}</i></a>
          <p>
            Journal satirique. Les articles sont des fictions humoristiques.<br />
            Ils ne rapportent pas des faits réels.
          </p>
        </div>
        <ul>
          <li><a href={url('redaction/')}>La rédaction</a></li>
          <li><a href={url('a-propos/')}>À propos</a></li>
          <li><a href={url('mentions-legales/')}>Mentions légales</a></li>
          <li><a href={url('plan-du-site/')}>Plan du site</a></li>
          <li><a href={url('rss.xml')}>Flux RSS</a></li>
          {analyticsId && !csp && <li><a href={url('mentions-legales/#donnees')} data-open-consent>Gérer mes cookies</a></li>}
        </ul>
      </div>
      <div class="wrap bottomline">
        <p class="copyright">© {new Date().getFullYear()} {publisher.url ? <a href={publisher.url} rel="noopener">clarté-web.fr</a> : 'clarté-web.fr'} – Tous droits réservés.</p>
        <div class="quality">
          <p>Un site léger et accessible, mesuré {qualityDate}</p>
          <ul>
            {quality.map((q) => (
              <li>
                <a href={q.url} target="_blank" rel="noopener noreferrer" aria-label={`Score ${q.name} ${q.score} : voir l'analyse (nouvelle fenêtre)`}>
                  <span class="q-name">{q.name}</span><span class:list={['q-score', q.score === 'B' && 'q-b']}>{q.score}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
    {!csp && (follow || !noindex) && <Consent />}
  </body>
</html>
